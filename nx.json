{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "develop",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json"
    ],
    "pythonWorkspace": [
      "{workspaceRoot}/.python-version",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/apps/backend/club-scraper/pyproject.toml",
      "{workspaceRoot}/apps/backend/competition-scraper/pyproject.toml",
      "{workspaceRoot}/libs/shared/python-contract-clients/pyproject.toml"
    ]
  },
  "plugins": [
    "@nx/expo/plugin",
    {
      "plugin": "@nx/maven",
      "options": {
        "targetNamePrefix": "mvn-",
        "verbose": false
      }
    },
    "@nxlv/python"
  ]
}
