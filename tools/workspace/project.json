{
  "name": "@blockout/workspace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "verify": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        {
          "target": "test-affected-containers"
        },
        {
          "projects": "com.blockout:backend",
          "target": "verify"
        },
        {
          "target": "verify-python"
        },
        {
          "projects": "@blockout/mobile",
          "target": "verify"
        }
      ]
    },
    "test-affected-containers": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/tools/workspace/scripts/affected-containers.test.mjs",
        "{workspaceRoot}/apps/backend/*/project.json",
        "{workspaceRoot}/apps/backend/shared-models/pom.xml"
      ],
      "options": {
        "command": "node --test tools/workspace/scripts/affected-containers.test.mjs"
      }
    },
    "verify-python": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "verify"
        },
        {
          "projects": "@blockout/club-scraper",
          "target": "verify"
        },
        {
          "projects": "@blockout/competition-scraper",
          "target": "verify"
        }
      ]
    }
  }
}
