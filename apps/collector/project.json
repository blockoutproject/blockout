{
  "name": "collector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/collector/src",
  "targets": {
    "serve": {
      "command": "./mvnw -B -ntp -pl apps/collector spring-boot:run",
      "continuous": true,
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "build": {
      "command": "./mvnw -B -ntp -pl apps/collector package -DskipTests",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "test": {
      "command": "./mvnw -B -ntp -pl apps/collector verify",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "typecheck": {
      "command": "./mvnw -B -ntp -pl apps/collector test-compile",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "lint": {
      "command": "./mvnw -B -ntp -pl apps/collector checkstyle:check"
    },
    "format-check": {
      "command": "./mvnw -B -ntp -pl apps/collector spotless:check"
    },
    "verify": {
      "command": "./mvnw -B -ntp -pl apps/collector verify",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "generate": {
      "command": "./mvnw -B -ntp -pl apps/collector generate-sources",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ],
      "outputs": ["{projectRoot}/target/generated-sources/openapi"]
    }
  },
  "implicitDependencies": ["http-contracts"]
}
