{
  "name": "collector",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/collector/src",
  "targets": {
    "serve": {
      "command": "./mvnw -B -ntp -pl apps/collector spring-boot:run",
      "continuous": true
    },
    "build": {
      "command": "./mvnw -B -ntp -pl apps/collector package -DskipTests"
    },
    "test": { "command": "./mvnw -B -ntp -pl apps/collector verify" },
    "typecheck": {
      "command": "./mvnw -B -ntp -pl apps/collector test-compile"
    },
    "lint": {
      "command": "./mvnw -B -ntp -pl apps/collector checkstyle:check"
    },
    "format-check": {
      "command": "./mvnw -B -ntp -pl apps/collector spotless:check"
    },
    "verify": { "command": "./mvnw -B -ntp -pl apps/collector verify" }
  }
}
