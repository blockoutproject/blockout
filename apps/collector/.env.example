# Source .env.local in the launching shell; Spring does not load dotenv files itself.
# Generated ingestion client; hosted environments use HTTPS.
BLOCKOUT_INGESTION_BASE_URL=http://localhost:8080
BLOCKOUT_INGESTION_TIMEOUT=15s
# Standard client_credentials registration. The provider's actual expires_in governs reuse.
# Replace these reserved inputs only for an authorized environment; keep the secret private.
BLOCKOUT_INGESTION_TOKEN_URI=https://identity.example.invalid/oauth/token
BLOCKOUT_INGESTION_AUDIENCE=ingestion-unconfigured
BLOCKOUT_INGESTION_CLIENT_ID=collector-unconfigured
BLOCKOUT_INGESTION_CLIENT_SECRET=
# The collector deliberately has no database credentials.

# Run exactly one collector instance per environment, including during replacement.
# Optional acquisition overrides; application.yaml owns conservative starting defaults.
# Provider transport and adapters are installed; scheduling and live qualification remain with F01.
# No acquisition starts automatically.
# BLOCKOUT_ACQUISITION_TIMEOUT=15s
# BLOCKOUT_ACQUISITION_MAX_RESPONSE_BYTES=8388608
# BLOCKOUT_ACQUISITION_MAX_REDIRECTS=3
# BLOCKOUT_ACQUISITION_CONCURRENCY=2
# BLOCKOUT_ACQUISITION_PERMITS_PER_PERIOD=1
# BLOCKOUT_ACQUISITION_REFRESH_PERIOD=1s
# BLOCKOUT_ACQUISITION_PERMIT_TIMEOUT=5s
# Override BLOCKOUT_ACQUISITION_FFVB_ORIGINS, BLOCKOUT_ACQUISITION_LNV_ORIGINS or
# BLOCKOUT_ACQUISITION_IGN_ORIGINS only with qualified comma-separated HTTP(S) origins.
# Redirects must remain within the same provider's allowed origins.
# Verified document-team-associations use ordinary external Spring YAML, with
# season-start-year, championship-reference, native-team-reference and xml-team-label.
# Load it with SPRING_CONFIG_ADDITIONAL_LOCATION; keep unqualified associations absent.
