{
  "name": "@blockout/competition-scraper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scrapers/competition-scraper",
  "projectType": "application",
  "tags": ["scope:scrapers", "type:application", "platform:python"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/scrapers/competition-scraper",
        "command": "python3 main.py"
      }
    },
    "syntax-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/scrapers/competition-scraper",
        "command": "python3 -m compileall -q ."
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/scrapers/competition-scraper",
        "command": "docker build --tag blockoutproject/blockout-scraper:latest ."
      }
    }
  }
}
