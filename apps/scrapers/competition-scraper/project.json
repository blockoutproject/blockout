{
  "name": "@blockout/competition-scraper",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scrapers/competition-scraper",
  "projectType": "application",
  "tags": ["scope:scrapers", "type:application", "platform:python"],
  "targets": {
    "serve": {
      "executor": "@nxlv/python:run-commands",
      "continuous": true,
      "dependsOn": [
        "@blockout/contracts:generate-python-clients",
        "@blockout/python-contract-clients:sync"
      ],
      "options": {
        "cwd": "apps/scrapers/competition-scraper",
        "command": "python main.py"
      }
    },
    "syntax-check": {
      "executor": "@nxlv/python:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/scrapers/competition-scraper",
        "command": "python -m compileall -q ."
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["@blockout/contracts:generate-python-clients"],
      "options": {
        "command": "docker build --file apps/scrapers/competition-scraper/Dockerfile --tag blockoutproject/blockout-scraper:latest ."
      },
      "configurations": {
        "ci": {
          "command": "docker build --file apps/scrapers/competition-scraper/Dockerfile --tag blockout-shadow/competition-scraper:${GITHUB_SHA} ."
        },
        "local": {
          "command": "docker build --file apps/scrapers/competition-scraper/Dockerfile --tag blockout-shadow/competition-scraper:local ."
        }
      }
    }
  }
}
