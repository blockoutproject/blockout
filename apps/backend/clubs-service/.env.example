# Copy to .env.local for direct Spring Boot execution.
APPLICATION_NAME=clubs
SERVER_PORT=8086
AUTH0_ISSUER=https://example.eu.auth0.com/
DATASOURCE_NAME=blockout_clubs
DATASOURCE_URL=jdbc:postgresql://localhost:5437/blockout_clubs
DATASOURCE_USERNAME=blockout_clubs
DATASOURCE_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=eu-west-3
AWS_S3_BUCKET_NAME=blockout-clubs
MAPBOX_ACCESS_TOKEN=change-me
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO
