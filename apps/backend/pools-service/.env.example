# Copy to .env.local for direct Spring Boot execution.
APPLICATION_NAME=pools
SERVER_PORT=8081
AUTH0_ISSUER=https://example.eu.auth0.com/
DATASOURCE_NAME=blockout_pools
DATASOURCE_URL=jdbc:postgresql://localhost:5432/blockout_pools
DATASOURCE_USERNAME=blockout_pools
DATASOURCE_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=change-me
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO
OUTBOX_PUBLISHER_ENABLED=true
POOLS_LIFECYCLE_EVENTS_V1_ENABLED=true
POOLS_LIFECYCLE_EVENTS_V2_ENABLED=false
OUTBOX_BATCH_SIZE=50
OUTBOX_RETENTION=7d
