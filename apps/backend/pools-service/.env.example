# Application
APPLICATION_NAME=pools
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO

# Local PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5432/pools
DATASOURCE_USERNAME=pools
DATASOURCE_PASSWORD=pools

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# External authentication - replace with development tenant values
AUTH0_ISSUER=https://replace-me.eu.auth0.com/
