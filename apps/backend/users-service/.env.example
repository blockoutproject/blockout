# Copy to .env.local for direct Spring Boot execution.
APPLICATION_NAME=users
SERVER_PORT=8085
AUTH0_ISSUER=https://example.eu.auth0.com/
AUTH0_DOMAIN=example.eu.auth0.com
AUTH0_CLIENT_ID=change-me
AUTH0_CLIENT_SECRET=change-me
AUTH0_AUDIENCE=https://api.blockout.example
AUTH0_DEFAULT_ROLE_ID=change-me
AUTH_API_KEY=change-me
DATASOURCE_NAME=blockout_users
DATASOURCE_URL=jdbc:postgresql://localhost:5436/blockout_users
DATASOURCE_USERNAME=blockout_users
DATASOURCE_PASSWORD=change-me
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=eu-west-3
AWS_S3_BUCKET_NAME=blockout-users
TEAM_API_URL=http://localhost:8082
POOL_API_URL=http://localhost:8081
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=50
OUTBOX_RETENTION=7d
