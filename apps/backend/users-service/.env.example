# Application
APPLICATION_NAME=users
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO

# Local PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5436/users
DATASOURCE_USERNAME=users
DATASOURCE_PASSWORD=users

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# Local application dependencies
TEAM_API_URL=http://localhost:8082/api/v1/teams
POOL_API_URL=http://localhost:8081/api/v1/pools

# External integrations - replace with development credentials
AUTH0_ISSUER=https://replace-me.eu.auth0.com/
AUTH0_DOMAIN=replace-me.eu.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_AUDIENCE=https://api.blockout.local
AUTH0_DEFAULT_ROLE_ID=replace-me
AUTH_API_KEY=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=eu-west-3
AWS_S3_BUCKET_NAME=replace-me
