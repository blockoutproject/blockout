# Application
APPLICATION_NAME=matches
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO

# Local PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5434/matches
DATASOURCE_USERNAME=matches
DATASOURCE_PASSWORD=matches

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# Local application dependency
USER_API_URL=http://localhost:8085/api/v1/users

# External authentication - replace with development tenant values
AUTH0_ISSUER=https://replace-me.eu.auth0.com/
