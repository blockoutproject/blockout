<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                            https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.blockout</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mobile-gateway</artifactId>
    <name>mobile-gateway</name>
    <description>Demo project for Spring Boot</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blockout</groupId>
            <artifactId>shared-models</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>6.0.1</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>auth0</artifactId>
			<version>2.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
    </dependencies>

    <build>
		<plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-mobile-gateway-server</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/mobile-gateway.json</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${openapi.generated-sources.root}/mobile-gateway-server</output>
                            <apiPackage>com.blockout.mobilegateway.generated.api</apiPackage>
                            <modelPackage>com.blockout.mobilegateway.generated.model</modelPackage>
                            <invokerPackage>com.blockout.mobilegateway.generated.invoker</invokerPackage>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <interfaceOnly>true</interfaceOnly>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-config-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/config.json</inputSpec>
                            <generatorName>java</generatorName>
                            <apiNameSuffix>Client</apiNameSuffix>
                            <output>${openapi.generated-sources.root}/config-client</output>
                            <apiPackage>com.blockout.config.client.api</apiPackage>
                            <modelPackage>com.blockout.config.client.model</modelPackage>
                            <invokerPackage>com.blockout.config.client.invoker</invokerPackage>
                            <configOptions>
                                <library>resttemplate</library>
                                <useJakartaEe>true</useJakartaEe>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-users-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/users.json</inputSpec>
                            <generatorName>java</generatorName>
                            <apiNameSuffix>Client</apiNameSuffix>
                            <output>${openapi.generated-sources.root}/users-client</output>
                            <apiPackage>com.blockout.mobilegateway.usersclient.api</apiPackage>
                            <modelPackage>com.blockout.mobilegateway.usersclient.model</modelPackage>
                            <invokerPackage>com.blockout.mobilegateway.usersclient.invoker</invokerPackage>
                            <configOptions>
                                <library>resttemplate</library>
                                <useJakartaEe>true</useJakartaEe>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-reports-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/reports.json</inputSpec>
                            <generatorName>java</generatorName>
                            <apiNameSuffix>Client</apiNameSuffix>
                            <output>${openapi.generated-sources.root}/reports-client</output>
                            <apiPackage>com.blockout.mobilegateway.reportsclient.api</apiPackage>
                            <modelPackage>com.blockout.mobilegateway.reportsclient.model</modelPackage>
                            <invokerPackage>com.blockout.mobilegateway.reportsclient.invoker</invokerPackage>
                            <configOptions>
                                <library>resttemplate</library>
                                <useJakartaEe>true</useJakartaEe>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-notification-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/notification.json</inputSpec>
                            <generatorName>java</generatorName>
                            <apiNameSuffix>Client</apiNameSuffix>
                            <output>${openapi.generated-sources.root}/notification-client</output>
                            <apiPackage>com.blockout.mobilegateway.notificationclient.api</apiPackage>
                            <modelPackage>com.blockout.mobilegateway.notificationclient.model</modelPackage>
                            <invokerPackage>com.blockout.mobilegateway.notificationclient.invoker</invokerPackage>
                            <configOptions>
                                <library>resttemplate</library>
                                <useJakartaEe>true</useJakartaEe>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-search-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../../libs/shared/contracts/generated/specs/search.json</inputSpec>
                            <generatorName>java</generatorName>
                            <apiNameSuffix>Client</apiNameSuffix>
                            <output>${openapi.generated-sources.root}/search-client</output>
                            <apiPackage>com.blockout.mobilegateway.searchclient.api</apiPackage>
                            <modelPackage>com.blockout.mobilegateway.searchclient.model</modelPackage>
                            <invokerPackage>com.blockout.mobilegateway.searchclient.invoker</invokerPackage>
                            <configOptions>
                                <library>resttemplate</library>
                                <useJakartaEe>true</useJakartaEe>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${openapi.generated-sources.root}/mobile-gateway-server/src/main/java</source>
                                <source>${openapi.generated-sources.root}/config-client/src/main/java</source>
                                <source>${openapi.generated-sources.root}/users-client/src/main/java</source>
                                <source>${openapi.generated-sources.root}/reports-client/src/main/java</source>
                                <source>${openapi.generated-sources.root}/notification-client/src/main/java</source>
                                <source>${openapi.generated-sources.root}/search-client/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
		</plugins>
    </build>
</project>
