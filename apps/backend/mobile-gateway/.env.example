# Application
APPLICATION_NAME=mobilegateway
LOGGING_LEVEL_ROOT=INFO
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Local application dependencies
MOBILE_GATEWAY_API_URL=http://localhost:8089/api/v1/mobile
MATCH_API_URL=http://localhost:8083/api/v1/matches
TEAM_API_URL=http://localhost:8082/api/v1/teams
POOL_API_URL=http://localhost:8081/api/v1/pools
CONFIG_API_URL=http://localhost:8090/api/v1/config
COMPETITION_API_URL=http://localhost:8084/api/v1/competitions
CLUB_API_URL=http://localhost:8086/api/v1/clubs
NOTIFICATION_API_URL=http://localhost:8092/api/v1/notifications
USER_API_URL=http://localhost:8085/api/v1/users
SEARCH_API_URL=http://localhost:8088/api/v1/search
REPORT_API_URL=http://localhost:8091/api/v1/reports

# External authentication
AUTH0_ISSUER=https://login.blockoutproject.com/
AUTH0_DOMAIN=login.blockoutproject.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_AUDIENCE=https://api.blockoutproject.com/

# FFVB proxy - replace when exercising the proxied route
FFVB_PROXY_HOST=localhost
FFVB_PROXY_PORT=8888

# Local-only signing key; never reuse in a deployed environment
PDF_LINK_TOKEN_SECRET=blockout-local-pdf-link-signing-key-change-in-deployment
