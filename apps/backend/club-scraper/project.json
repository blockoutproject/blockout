{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/club-scraper",
  "projectType": "application",
  "sourceRoot": "apps/backend/club-scraper",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "pythonWorkspace", "sharedGlobals"]
  },
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python main.py local"
      }
    },
    "syntax-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "generate"
        }
      ],
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m compileall -q main.py scraper tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "generate"
        }
      ],
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "generate"
        }
      ],
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m ruff check ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check --fix .",
          "uv run --locked --no-sync python -m ruff format ."
        ],
        "parallel": false
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check .",
          "uv run --locked --no-sync python -m ruff format --check ."
        ],
        "parallel": false
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["default", "^default", "{workspaceRoot}/.dockerignore"],
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "generate"
        }
      ],
      "options": {
        "command": "docker build --build-arg APP_REVISION=0000000000000000000000000000000000000000 --file apps/backend/club-scraper/Dockerfile --tag blockout-club-scraper:local ."
      }
    }
  },
  "tags": ["language:python"]
}
