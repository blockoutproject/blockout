{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/club-scraper",
  "projectType": "application",
  "sourceRoot": "apps/backend/club-scraper",
  "implicitDependencies": ["@blockout/python-contract-clients"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python main.py local"
      }
    },
    "syntax-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m compileall -q main.py scraper tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "uv run --locked --no-sync python -m ruff check ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check --fix .",
          "uv run --locked --no-sync python -m ruff format ."
        ],
        "parallel": false
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check .",
          "uv run --locked --no-sync python -m ruff format --check ."
        ],
        "parallel": false
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "^contractSources"
      ],
      "dependsOn": ["^verify"],
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check .",
          "uv run --locked --no-sync python -m compileall -q main.py scraper tests",
          "uv run --locked --no-sync python -m pytest -q"
        ],
        "parallel": false
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/backend/club-scraper/Dockerfile -t blockout/club-scraper:local ."
      }
    }
  },
  "tags": ["scope:backend", "type:application", "language:python"]
}
