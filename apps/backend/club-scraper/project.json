{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/club-scraper",
  "projectType": "application",
  "sourceRoot": "apps/backend/club-scraper",
  "targets": {
    "serve": {
      "executor": "@nxlv/python:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "python main.py local",
        "installDependenciesIfNotExists": true
      }
    },
    "syntax-check": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "python -m compileall -q main.py scraper tests",
        "installDependenciesIfNotExists": true
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "python -m pytest -q",
        "installDependenciesIfNotExists": true
      }
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "command": "python -m ruff check .",
        "installDependenciesIfNotExists": true
      }
    },
    "format": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "python -m ruff check --fix .",
          "python -m ruff format ."
        ],
        "parallel": false,
        "installDependenciesIfNotExists": true
      }
    },
    "format-check": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "cwd": "apps/backend/club-scraper",
        "commands": [
          "python -m ruff check .",
          "python -m ruff format --check ."
        ],
        "parallel": false,
        "installDependenciesIfNotExists": true
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "docker build -f apps/backend/club-scraper/Dockerfile -t blockout/club-scraper:local ."
      }
    }
  },
  "tags": [
    "scope:backend",
    "type:application",
    "language:python"
  ]
}
