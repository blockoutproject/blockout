{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "targets": {
    "serve": {
      "command": "./mvnw -B -ntp -pl apps/backend spring-boot:run",
      "continuous": true,
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "build": {
      "command": "./mvnw -B -ntp -pl apps/backend package -DskipTests",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "test": {
      "command": "./mvnw -B -ntp -pl apps/backend verify",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "typecheck": {
      "command": "./mvnw -B -ntp -pl apps/backend test-compile",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "lint": {
      "command": "./mvnw -B -ntp -pl apps/backend checkstyle:check"
    },
    "format-check": {
      "command": "./mvnw -B -ntp -pl apps/backend spotless:check"
    },
    "verify": {
      "command": "./mvnw -B -ntp -pl apps/backend verify",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ]
    },
    "migrate": {
      "command": "./mvnw -B -ntp -pl apps/backend liquibase:update"
    },
    "generate": {
      "command": "./mvnw -B -ntp -pl apps/backend generate-sources",
      "dependsOn": [
        {
          "target": "bundle",
          "projects": ["http-contracts"]
        }
      ],
      "outputs": ["{projectRoot}/target/generated-sources/openapi"]
    }
  },
  "implicitDependencies": ["http-contracts"]
}
