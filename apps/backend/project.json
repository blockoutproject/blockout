{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "targets": {
    "serve": {
      "command": "./mvnw -B -ntp -pl apps/backend spring-boot:run",
      "continuous": true
    },
    "build": {
      "command": "./mvnw -B -ntp -pl apps/backend -am package -DskipTests"
    },
    "test": { "command": "./mvnw -B -ntp -pl apps/backend -am verify" },
    "typecheck": {
      "command": "./mvnw -B -ntp -pl apps/backend -am test-compile"
    },
    "lint": {
      "command": "./mvnw -B -ntp -pl apps/backend -am checkstyle:check"
    },
    "format-check": {
      "command": "./mvnw -B -ntp -pl apps/backend -am spotless:check"
    },
    "verify": { "command": "./mvnw -B -ntp -pl apps/backend -am verify" }
  }
}
