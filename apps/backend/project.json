{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/src",
  "targets": {
    "serve": {
      "command": "./mvnw -B -ntp -pl apps/backend spring-boot:run",
      "continuous": true
    },
    "build": {
      "command": "./mvnw -B -ntp -pl apps/backend package -DskipTests"
    },
    "test": { "command": "./mvnw -B -ntp -pl apps/backend verify" },
    "typecheck": {
      "command": "./mvnw -B -ntp -pl apps/backend test-compile"
    },
    "lint": {
      "command": "./mvnw -B -ntp -pl apps/backend checkstyle:check"
    },
    "format-check": {
      "command": "./mvnw -B -ntp -pl apps/backend spotless:check"
    },
    "verify": { "command": "./mvnw -B -ntp -pl apps/backend verify" }
  }
}
