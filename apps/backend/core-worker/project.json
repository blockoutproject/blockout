{
  "name": "@blockout/core-worker",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "container": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/scripts/backend-foundation/**/*",
        "{workspaceRoot}/.dockerignore",
        "{workspaceRoot}/libs/shared/contracts/specs/**/*"
      ],
      "options": {
        "command": "scripts/backend-foundation/build.sh core-worker",
        "cwd": "."
      }
    }
  },
  "tags": ["type:application", "scope:backend", "language:java"]
}
