# Source .env.local in the launching shell; Spring does not load dotenv files itself.
SERVER_PORT=8080
# Database inputs become active with F13 T015/T016; no database is opened by setup.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blockout
SPRING_DATASOURCE_USERNAME=blockout_app
SPRING_DATASOURCE_PASSWORD=local-app-only
# Use this separate role only for explicit migrations, never backend startup.
BLOCKOUT_MIGRATION_USERNAME=blockout_migration
BLOCKOUT_MIGRATION_PASSWORD=local-migration-only
