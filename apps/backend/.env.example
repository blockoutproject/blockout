# Source .env.local in the launching shell; Spring does not load dotenv files itself.
SERVER_PORT=8080
# Application credentials validate the schema but cannot migrate it.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blockout
SPRING_DATASOURCE_USERNAME=blockout_app
SPRING_DATASOURCE_PASSWORD=local-app-only

# Bounded on-demand document transport; the story adapter owns binding/qualification.
# No source is activated until approved exact HTTP(S) origins are configured privately.
# Origin checks also apply to every redirect; this is not an arbitrary URL relay.
# BLOCKOUT_CONSULTATION_DOCUMENTS_CONNECTTIMEOUT=3s
# BLOCKOUT_CONSULTATION_DOCUMENTS_READTIMEOUT=5s
# BLOCKOUT_CONSULTATION_DOCUMENTS_MAXBYTES=20971520
# BLOCKOUT_CONSULTATION_DOCUMENTS_MAXREDIRECTS=3
# BLOCKOUT_CONSULTATION_DOCUMENTS_ALLOWEDORIGINS=

# Search is opt-in. Load local/opensearch/backend.env
# after this file for the isolated Compose instance (see README). Credentials are backend-only.
# Search aliases stay inside this environment-owned namespace.
BLOCKOUT_SEARCH_INDEX_PREFIX=blockout-local-search
# BLOCKOUT_SEARCH_ENABLED=true
# BLOCKOUT_SEARCH_ENDPOINT=https://localhost:9200
# BLOCKOUT_SEARCH_USERNAME=
# BLOCKOUT_SEARCH_PASSWORD=
# SPRING_SSL_BUNDLE_PEM_OPENSEARCH_TRUSTSTORE_CERTIFICATE=/absolute/path/to/ca.pem
# BLOCKOUT_SEARCH_CONNECTTIMEOUTMILLIS=3000
# BLOCKOUT_SEARCH_REQUESTTIMEOUTMILLIS=5000

# Public Auth0 default-profile inputs (azp identifies the calling client).
# Reserved placeholders trust no live provider. Set each environment's authorized values privately.
BLOCKOUT_SECURITY_ISSUER=https://identity.example.invalid/
BLOCKOUT_SECURITY_MOBILE_AUDIENCE=mobile-unconfigured
BLOCKOUT_SECURITY_MOBILE_CLIENT_ID=mobile-unconfigured
BLOCKOUT_SECURITY_INGESTION_AUDIENCE=ingestion-unconfigured
BLOCKOUT_SECURITY_INGESTION_CLIENT_ID=collector-unconfigured

# Fixed retirement thresholds for the installed V1 applications, independent of F12 settings.
# Set only the qualified first V2 release versions and existing listing URLs before cutover.
# Native Spring binding; omit all four until qualified. Missing configuration serves HTTP 503.
# BLOCKOUT_LEGACY_MINVERSIONIOS=
# BLOCKOUT_LEGACY_MINVERSIONANDROID=
# BLOCKOUT_LEGACY_STOREURLIOS=
# BLOCKOUT_LEGACY_STOREURLANDROID=

# Server-only provider inputs for F05 adapters (T011/T034), activated in T015/T036.
# Keep the native Spring OAuth client registration absent until its M2M client is configured.
# Grant only read:users and delete:users on the existing tenant's Management API.
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_CLIENTID=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_CLIENTSECRET=
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_AUTHORIZATIONGRANTTYPE=client_credentials
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_CLIENTAUTHENTICATIONMETHOD=client_secret_post
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_SCOPE=read:users,delete:users
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_AUTH0_TOKENURI=
# BLOCKOUT_ACCOUNTS_AUTH0_AUDIENCE=
# Cleanup remains disabled until the environment and original-target scope are qualified.
# BLOCKOUT_ACCOUNTS_CLEANUP_ENVIRONMENT=disabled
# Dedicated test-only database connection, required for preproduction Auth0 deletion.
# BLOCKOUT_ACCOUNTS_CLEANUP_PREPRODUCTION_CONNECTION=
# Original RevenueCat project and backend v2 customer_information:customers:read_write key.
# BLOCKOUT_ACCOUNTS_CLEANUP_REVENUECAT_PROJECT_ID=
# BLOCKOUT_ACCOUNTS_CLEANUP_REVENUECAT_SECRET_KEY=
# Exact verified test-only customer IDs (comma-separated); never email-derived mappings.
# BLOCKOUT_ACCOUNTS_CLEANUP_PREPRODUCTION_REVENUECAT_IDS=
# Token requests use Spring's bounded OAuth2 client. The official Auth0 Management SDK
# uses a bounded native transport. Both disable redirects and do not replay dispatched
# POST/DELETE requests; native connection establishment remains inside the total deadline.
# No provider call or token request is made by this setup alone.

# F07 transport stays disabled until the isolated Expo project/credentials are authorized.
# Match EXPO_PROJECT_ID in the native build; one enabled backend sender per project.
BLOCKOUT_NOTIFICATIONS_PUSH_ENABLED=false
# BLOCKOUT_NOTIFICATIONS_PUSH_PROJECT_ID=
# Private server token for Expo enhanced push security; never expose through EXPO_PUBLIC_*.
# BLOCKOUT_NOTIFICATIONS_PUSH_ACCESS_TOKEN=
# Native SDK HTTP deadlines use spring.http.clients (application.yaml): 3s connect, 5s read.
