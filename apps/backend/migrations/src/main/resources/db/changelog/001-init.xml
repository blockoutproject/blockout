<?xml version="1.0" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="001-foundation" author="blockout">
        <createTable schemaName="operations" tableName="schema_metadata">
            <column name="id" type="integer">
                <constraints primaryKey="true" primaryKeyName="pk_schema_metadata" nullable="false"/>
            </column>
            <column name="generation" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <insert schemaName="operations" tableName="schema_metadata">
            <column name="id" valueNumeric="1"/>
            <column name="generation" valueNumeric="5"/>
        </insert>
        <createTable schemaName="operations" tableName="jobs">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_jobs"/>
            </column>
            <column name="job_type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="deduplication_key" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="available_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="max_attempts" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="lease_token" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="lease_expires_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="finished_at" type="timestamptz">
                <constraints nullable="true"/>
            </column>
            <column name="last_error_code" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="operations" tableName="jobs" columnNames="job_type,deduplication_key" constraintName="uq_jobs_type_key"/>
        <createIndex schemaName="operations" tableName="jobs" indexName="idx_jobs_available">
            <column name="state"/>
            <column name="available_at"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex schemaName="operations" tableName="jobs" indexName="idx_jobs_lease">
            <column name="state"/>
            <column name="lease_expires_at"/>
        </createIndex>
        <createIndex schemaName="operations" tableName="jobs" indexName="idx_jobs_finished">
            <column name="state"/>
            <column name="finished_at"/>
        </createIndex>
        <createTable schemaName="identity" tableName="users">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_users"/>
            </column>
            <column name="pseudo" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="pseudo_key" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(320)">
                <constraints nullable="true"/>
            </column>
            <column name="first_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="last_name" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="phone_number" type="varchar(64)">
                <constraints nullable="true"/>
            </column>
            <column name="picture_url" type="varchar(2048)">
                <constraints nullable="true"/>
            </column>
            <column name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable schemaName="identity" tableName="external_identities">
            <column name="issuer" type="varchar(512)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_external_identities"/>
            </column>
            <column name="subject" type="varchar(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_external_identities"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable schemaName="identity" tableName="billing_bindings">
            <column name="user_id" type="uuid">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_billing_bindings"/>
            </column>
            <column name="project_id" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="environment" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="identity" tableName="users" columnNames="pseudo_key" constraintName="uq_identity_pseudo"/>
        <addUniqueConstraint schemaName="identity" tableName="billing_bindings" columnNames="project_id,environment,customer_id" constraintName="uq_identity_billing_customer"/>
        <addForeignKeyConstraint baseTableSchemaName="identity" baseTableName="external_identities" baseColumnNames="user_id" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_identity_external_user" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="identity" baseTableName="billing_bindings" baseColumnNames="user_id" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_identity_billing_user" onDelete="RESTRICT"/>
        <createIndex schemaName="identity" tableName="external_identities" indexName="idx_identity_external_user">
            <column name="user_id"/>
        </createIndex>
        <createTable schemaName="identity" tableName="subscription_states">
            <column name="user_id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_subscription_states"/></column>
            <column name="positive" type="boolean"><constraints nullable="true"/></column>
            <column name="verified_at" type="timestamptz"><constraints nullable="true"/></column>
            <column name="access_expires_at" type="timestamptz"><constraints nullable="true"/></column>
            <column name="requested_revision" type="bigint"><constraints nullable="false"/></column>
            <column name="processed_revision" type="bigint"><constraints nullable="false"/></column>
            <column name="job_id" type="uuid"><constraints nullable="true"/></column>
            <column name="requested_at" type="timestamptz"><constraints nullable="true"/></column>
            <column name="next_refresh_at" type="timestamptz"><constraints nullable="true"/></column>
            <column name="failure_code" type="varchar(50)"><constraints nullable="true"/></column>
            <column name="failed_at" type="timestamptz"><constraints nullable="true"/></column>
        </createTable>
        <createTable schemaName="identity" tableName="webhook_receipts">
            <column name="event_id" type="varchar(255)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_webhook_receipts"/></column>
            <column name="event_type" type="varchar(100)"><constraints nullable="false"/></column>
            <column name="event_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="received_at" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableSchemaName="identity" baseTableName="subscription_states" baseColumnNames="user_id" referencedTableSchemaName="identity" referencedTableName="billing_bindings" referencedColumnNames="user_id" constraintName="fk_subscription_binding" onDelete="RESTRICT"/>
        <createIndex schemaName="identity" tableName="subscription_states" indexName="idx_subscription_due"><column name="positive"/><column name="next_refresh_at"/><column name="user_id"/></createIndex>
        <createTable schemaName="identity" tableName="user_roles">
            <column name="user_id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_user_roles"/></column>
            <column name="role" type="varchar(30)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_identity_user_roles"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableSchemaName="identity" baseTableName="user_roles" baseColumnNames="user_id" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_user_roles_user_id" onDelete="RESTRICT"/>
        <createTable schemaName="sports" tableName="clubs">
            <column name="id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_clubs"/></column>
            <column name="ffvb_code" type="varchar(32)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"><constraints nullable="true"/></column>
        </createTable>
        <addUniqueConstraint schemaName="sports" tableName="clubs" columnNames="ffvb_code" constraintName="uq_sports_clubs"/>
        <createTable schemaName="sports" tableName="divisions">
            <column name="id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_divisions"/></column>
            <column name="name" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="active" type="boolean"><constraints nullable="false"/></column>
            <column name="updated_by" type="uuid"><constraints nullable="true"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="true"/></column>
        </createTable>
        <addUniqueConstraint schemaName="sports" tableName="divisions" columnNames="name" constraintName="uq_sports_divisions"/>
        <createTable schemaName="sports" tableName="teams">
            <column name="id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_teams"/></column>
            <column name="club_id" type="uuid"><constraints nullable="false"/></column>
            <column name="season" type="varchar(9)"><constraints nullable="false"/></column>
            <column name="division_id" type="uuid"><constraints nullable="false"/></column>
            <column name="format" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="gender" type="varchar(10)"><constraints nullable="false"/></column>
            <column name="canonical_name" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="display_name" type="varchar(255)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint schemaName="sports" tableName="teams" columnNames="club_id,season,division_id,format,gender,canonical_name" constraintName="uq_sports_teams"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="teams" baseColumnNames="club_id" referencedTableSchemaName="sports" referencedTableName="clubs" referencedColumnNames="id" constraintName="fk_teams_club_id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="teams" baseColumnNames="division_id" referencedTableSchemaName="sports" referencedTableName="divisions" referencedColumnNames="id" constraintName="fk_teams_division_id" onDelete="RESTRICT"/>
        <createTable schemaName="sports" tableName="pools">
            <column name="id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_pools"/></column>
            <column name="provider" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="organizer" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="season" type="varchar(9)"><constraints nullable="false"/></column>
            <column name="code" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="active" type="boolean"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint schemaName="sports" tableName="pools" columnNames="provider,organizer,season,code" constraintName="uq_sports_pools"/>
        <createTable schemaName="sports" tableName="team_pool_memberships">
            <column name="pool_id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_team_pool_memberships"/></column>
            <column name="team_id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_team_pool_memberships"/></column>
            <column name="active" type="boolean"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="team_pool_memberships" baseColumnNames="pool_id" referencedTableSchemaName="sports" referencedTableName="pools" referencedColumnNames="id" constraintName="fk_team_pool_memberships_pool_id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="team_pool_memberships" baseColumnNames="team_id" referencedTableSchemaName="sports" referencedTableName="teams" referencedColumnNames="id" constraintName="fk_team_pool_memberships_team_id" onDelete="RESTRICT"/>
        <createTable schemaName="sports" tableName="ffvb_configuration">
            <column name="id" type="integer"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_ffvb_configuration"/></column>
            <column name="enabled" type="boolean"><constraints nullable="false"/></column>
            <column name="season" type="varchar(9)"><constraints nullable="true"/></column>
            <column name="updated_by" type="uuid"><constraints nullable="true"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="true"/></column>
        </createTable>
        <insert schemaName="sports" tableName="ffvb_configuration"><column name="id" valueNumeric="1"/><column name="enabled" valueBoolean="false"/></insert>
        <createTable schemaName="sports" tableName="ffvb_sources">
            <column name="code" type="varchar(16)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_ffvb_sources"/></column>
        </createTable>
        <createTable schemaName="sports" tableName="ffvb_mappings">
            <column name="id" type="uuid"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_sports_ffvb_mappings"/></column>
            <column name="organizer" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="label" type="varchar(255)"><constraints nullable="false"/></column>
            <column name="division_id" type="uuid"><constraints nullable="true"/></column>
            <column name="format" type="varchar(20)"><constraints nullable="true"/></column>
            <column name="gender" type="varchar(10)"><constraints nullable="true"/></column>
            <column name="updated_by" type="uuid"><constraints nullable="true"/></column>
            <column name="updated_at" type="timestamptz"><constraints nullable="true"/></column>
        </createTable>
        <addUniqueConstraint schemaName="sports" tableName="ffvb_mappings" columnNames="organizer,label" constraintName="uq_sports_ffvb_mappings"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="ffvb_mappings" baseColumnNames="division_id" referencedTableSchemaName="sports" referencedTableName="divisions" referencedColumnNames="id" constraintName="fk_ffvb_mappings_division_id" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="divisions" baseColumnNames="updated_by" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_divisions_updated_by" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="ffvb_configuration" baseColumnNames="updated_by" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_ffvb_configuration_updated_by" onDelete="RESTRICT"/>
        <addForeignKeyConstraint baseTableSchemaName="sports" baseTableName="ffvb_mappings" baseColumnNames="updated_by" referencedTableSchemaName="identity" referencedTableName="users" referencedColumnNames="id" constraintName="fk_ffvb_mappings_updated_by" onDelete="RESTRICT"/>
        <!-- Community Liquibase has no native privilege change; grants are the only SQL exception. -->
        <sql>GRANT SELECT ON operations.schema_metadata TO blockout_api, blockout_worker;
GRANT SELECT, INSERT ON operations.jobs TO blockout_api;
GRANT SELECT, INSERT, UPDATE, DELETE ON operations.jobs TO blockout_worker;
GRANT SELECT, INSERT ON identity.users, identity.external_identities, identity.billing_bindings TO blockout_api;
GRANT SELECT ON identity.users, identity.external_identities, identity.billing_bindings TO blockout_worker;
GRANT SELECT, INSERT, UPDATE ON identity.subscription_states TO blockout_api, blockout_worker;
GRANT SELECT, INSERT ON identity.webhook_receipts TO blockout_api;
GRANT SELECT ON identity.webhook_receipts TO blockout_worker;
GRANT SELECT ON identity.user_roles TO blockout_api, blockout_worker;
GRANT SELECT ON ALL TABLES IN SCHEMA sports TO blockout_api, blockout_worker;
GRANT INSERT, UPDATE ON sports.divisions, sports.ffvb_configuration, sports.ffvb_mappings TO blockout_api;
GRANT INSERT, DELETE ON sports.ffvb_sources TO blockout_api;</sql>
    </changeSet>
</databaseChangeLog>
