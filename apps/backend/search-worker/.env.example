# Application
APPLICATION_NAME=workersearch
LOGGING_LEVEL_ROOT=INFO

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# Local Elasticsearch (security is disabled by the local Compose service)
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic

# Local application dependencies
CLUB_API_URL=http://localhost:8086/api/v1/clubs
TEAM_API_URL=http://localhost:8082/api/v1/teams
POOL_API_URL=http://localhost:8081/api/v1/pools
CONFIG_API_URL=http://localhost:8090/api/v1/config

# External authentication - replace with development tenant values
AUTH0_DOMAIN=replace-me.eu.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
AUTH0_AUDIENCE=https://api.blockout.local
