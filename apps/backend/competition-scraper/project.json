{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/competition-scraper",
  "projectType": "application",
  "sourceRoot": "apps/backend/competition-scraper",
  "implicitDependencies": ["@blockout/python-contract-clients"],
  "release": {
    "docker": {
      "repositoryName": "blockoutproject/blockout-scraper"
    }
  },
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "command": "uv run --locked --no-sync python main.py local"
      }
    },
    "syntax-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "verify"
        }
      ],
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "command": "uv run --locked --no-sync python -m compileall -q main.py scraper tests"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "verify"
        }
      ],
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "command": "uv run --locked --no-sync python -m pytest -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/python-contract-clients",
          "target": "verify"
        }
      ],
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "command": "uv run --locked --no-sync python -m ruff check ."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check --fix .",
          "uv run --locked --no-sync python -m ruff format ."
        ],
        "parallel": false
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend/competition-scraper",
        "commands": [
          "uv run --locked --no-sync python -m ruff check .",
          "uv run --locked --no-sync python -m ruff format --check ."
        ],
        "parallel": false
      }
    },
    "verify": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": ["lint", "syntax-check", "test"]
    }
  },
  "tags": ["scope:backend", "type:application", "language:python"]
}
