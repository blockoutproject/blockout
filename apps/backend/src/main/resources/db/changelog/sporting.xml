    <addUniqueConstraint tableName="sporting_match" columnNames="pool_id, reference" constraintName="uk_match_identity"/>
    <!-- Scope reads use these parent keys; the native-identity indexes lead with other columns. -->
    <createIndex tableName="sporting_pool" indexName="ix_pool_pack">
      <column name="pack_id"/>
    </createIndex>
    <createIndex tableName="sporting_participation" indexName="ix_participation_pool">
      <column name="pool_id"/>
    </createIndex>
    <createIndex tableName="sporting_division" indexName="uk_division_name" unique="true">
      <column name="lower(name)" computed="true"/>
    </createIndex>
    <!-- Liquibase's native unique/index changes do not express PostgreSQL NULLS NOT DISTINCT
         or partial indexes. These preserve optional context and the two actual team keys. -->
    <sql dbms="postgresql"><![CDATA[
      CREATE UNIQUE INDEX uk_pool_identity ON sporting_pool
        (provider, season_id, organizer_reference, competition_reference, tour_reference, group_reference, reference)
        NULLS NOT DISTINCT;
      CREATE UNIQUE INDEX uk_team_ffvb ON sporting_team
        (season_id, club_id, division_id, format, gender, comparison_name) WHERE provider = 'FFVB';
      CREATE UNIQUE INDEX uk_team_lnv ON sporting_team
        (season_id, organizer_reference, competition_reference, native_reference) WHERE provider = 'LNV';
      ALTER TABLE sporting_team ADD CONSTRAINT ck_team_ffvb_club CHECK (provider != 'FFVB' OR club_id IS NOT NULL);
      ALTER TABLE sporting_team ADD CONSTRAINT ck_team_lnv_reference CHECK (provider != 'LNV' OR native_reference IS NOT NULL);
      ALTER TABLE sporting_match ADD CONSTRAINT ck_match_distinct_teams CHECK (home_team_id != away_team_id);
    ]]></sql>
  </changeSet>

