<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <!-- Creation baseline; the master changelog owns applied-history and no-reset policy. -->
  <changeSet id="notifications-baseline" author="blockout">
    <createTable tableName="match_announcement">
      <column name="match_id" type="UUID"><constraints nullable="false" primaryKey="true"/></column>
      <column name="live_processed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="result_processed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="post_result_processed" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
      <column name="result_composition" type="VARCHAR(255)"/>
    </createTable>
    <addForeignKeyConstraint baseTableName="match_announcement" baseColumnNames="match_id" referencedTableName="sporting_match" referencedColumnNames="id" constraintName="fk_announcement_match" onDelete="CASCADE"/>
    <createTable tableName="notification">
      <column name="id" type="UUID"><constraints nullable="false" primaryKey="true"/></column>
      <column name="account_id" type="UUID"><constraints nullable="false"/></column>
      <column name="match_id" type="UUID"><constraints nullable="false"/></column>
      <column name="family" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="variant" type="VARCHAR(255)"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
      <column name="is_read" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="notification" baseColumnNames="account_id" referencedTableName="account" referencedColumnNames="id" constraintName="fk_notification_account" onDelete="CASCADE"/>
    <addForeignKeyConstraint baseTableName="notification" baseColumnNames="match_id" referencedTableName="sporting_match" referencedColumnNames="id" constraintName="fk_notification_match" onDelete="CASCADE"/>
    <addUniqueConstraint tableName="notification" columnNames="account_id,match_id,family" constraintName="uk_notification_owner_match_family"/>
    <createIndex tableName="notification" indexName="ix_notification_owner_date_id">
      <column name="account_id"/><column name="created_at" descending="true"/><column name="id" descending="true"/>
    </createIndex>
    <createIndex tableName="notification" indexName="ix_notification_owner_read">
      <column name="account_id"/><column name="is_read"/>
    </createIndex>
    <createIndex tableName="notification" indexName="ix_notification_age"><column name="created_at"/></createIndex>
    <createTable tableName="push_subscription">
      <column name="id" type="UUID"><constraints nullable="false" primaryKey="true"/></column>
      <column name="subscription_id" type="UUID"><constraints nullable="false"/></column>
      <column name="installation_id" type="UUID"><constraints nullable="false"/></column>
      <column name="account_id" type="UUID"><constraints nullable="false"/></column>
      <column name="expo_push_token" type="TEXT"><constraints nullable="false"/></column>
      <column name="revision" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="push_subscription" baseColumnNames="account_id" referencedTableName="account" referencedColumnNames="id" constraintName="fk_push_subscription_account" onDelete="CASCADE"/>
    <addUniqueConstraint tableName="push_subscription" columnNames="subscription_id" constraintName="uk_push_subscription_connection"/>
    <addUniqueConstraint tableName="push_subscription" columnNames="installation_id" constraintName="uk_push_subscription_installation"/>
    <addUniqueConstraint tableName="push_subscription" columnNames="expo_push_token" constraintName="uk_push_subscription_address"/>
    <createIndex tableName="push_subscription" indexName="ix_push_subscription_account"><column name="account_id"/></createIndex>
  </changeSet>
</databaseChangeLog>
