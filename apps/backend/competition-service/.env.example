# Application
APPLICATION_NAME=competitions
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO

# Local PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5435/competition
DATASOURCE_USERNAME=competition
DATASOURCE_PASSWORD=competition

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# External authentication - replace with development tenant values
AUTH0_ISSUER=https://replace-me.eu.auth0.com/
