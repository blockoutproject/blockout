# Application
APPLICATION_NAME=teams
JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=INFO

# Local PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5433/teams
DATASOURCE_USERNAME=teams
DATASOURCE_PASSWORD=teams

# Local RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=blockout
RABBITMQ_PASSWORD=blockout

# External integrations - replace with development credentials
AUTH0_ISSUER=https://replace-me.eu.auth0.com/
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=eu-west-3
AWS_S3_BUCKET_NAME=replace-me
