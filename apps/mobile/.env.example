# Expo loads .env.local from this application's directory.
# Android emulator: use http://10.0.2.2:8080; a phone needs the host's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Public Auth0 inputs. Replace these reserved values in each EAS environment.
# Use the same tenant, but separate native clients and API audiences for production/preproduction.
# Client ID and audience must match the backend's BLOCKOUT_SECURITY_MOBILE_* inputs.
EXPO_PUBLIC_AUTH0_DOMAIN=identity.example.invalid
EXPO_PUBLIC_AUTH0_CLIENT_ID=mobile-unconfigured
EXPO_PUBLIC_AUTH0_AUDIENCE=mobile-unconfigured
# Rebuild after changing the domain. Keep the SDK's default callback/logout URLs:
# <applicationId>.auth0://<domain>/ios/<applicationId>/callback
# <applicationId>.auth0://<domain>/android/<applicationId>/callback
# Register both under Allowed Callback URLs and Allowed Logout URLs on that native client.
# app.config.ts owns each variant's applicationId; provider activation belongs to F05 T015/T036.

# EAS profiles need the existing project's actual slug in GitHub and EAS environments.
# Ordinary local development does not need it. F14 owns the published version in app.config.ts.
# EXPO_PROJECT_SLUG=

# Public RevenueCat SDK inputs, exposed through Constants.expoConfig.extra.revenueCat.
# Never supply a private RevenueCat REST API key. Empty inputs leave Pro unconfigured.
# Use dedicated test accounts in the existing project; sandbox access stays Anybody.
# A Test Store key takes precedence on both platforms for local/development/preview.
# Leave it empty and supply platform keys for real Apple/Google sandbox qualification.
# Production candidates reject Test Store keys, including ones in platform inputs.
REVENUECAT_TEST_STORE_API_KEY=
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
# Select the separate V2 offering explicitly; never fall back to the current offering.
REVENUECAT_V2_OFFERING_ID=
# Existing Customer Center Custom Action identifier that closes Pro and opens F10.
# Provider setup (including no Customer Center purchase offering or second support channel)
# and actual store qualification remain F09 T026/T027 and F14 responsibilities.
REVENUECAT_SUPPORT_ACTION_ID=

# Empty by default. Reports require an explicitly configured native release build.
# This public DSN is not an upload credential. Rebuild native apps after changing it.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=preproduction
# Source-map/debug-symbol upload uses private build variables SENTRY_ORG,
# SENTRY_PROJECT and SENTRY_AUTH_TOKEN. Never prefix the token with EXPO_PUBLIC_.
