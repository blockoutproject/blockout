{
  "cli": {
    "version": "25.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.18.0",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "APP_VARIANT": "development" }
    },
    "preview": {
      "node": "24.18.0",
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "preview" }
    },
    "production": {
      "node": "24.18.0",
      "environment": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  }
}
