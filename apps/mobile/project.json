{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mobile/src",
  "targets": {
    "serve": {
      "command": "npm run start --workspace=@blockout/mobile",
      "continuous": true
    },
    "android": { "command": "npm run android --workspace=@blockout/mobile" },
    "ios": { "command": "npm run ios --workspace=@blockout/mobile" },
    "build": { "command": "npm run build --workspace=@blockout/mobile" },
    "test": { "command": "npm run test --workspace=@blockout/mobile" },
    "typecheck": {
      "command": "npm run typecheck --workspace=@blockout/mobile"
    },
    "lint": { "command": "npm run lint --workspace=@blockout/mobile" },
    "format-check": {
      "command": "npm run format:check --workspace=@blockout/mobile"
    },
    "doctor": { "command": "npm run doctor --workspace=@blockout/mobile" },
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "commands": [
          "npm run format:check --workspace=@blockout/mobile",
          "npm run lint --workspace=@blockout/mobile",
          "npm run typecheck --workspace=@blockout/mobile",
          "npm run test --workspace=@blockout/mobile",
          "npm run build --workspace=@blockout/mobile",
          "npm run doctor --workspace=@blockout/mobile"
        ]
      }
    }
  }
}
