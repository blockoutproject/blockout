{
  "name": "@blockout/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "npm install --global npm@12.0.1",
    "eas-build-post-install": "npx nx run mobile:generate --output-style=static",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export",
    "format:check": "prettier --check --ignore-path ../../.prettierignore .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --runInBand",
    "doctor": "expo-doctor",
    "generate": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "5.104.3",
    "expo": "57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.15",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.28",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-hook-form": "7.90.0",
    "react-native": "0.86.3",
    "react-native-auth0": "5.11.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.21.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "orval": "8.41.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
