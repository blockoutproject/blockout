  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.21.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "orval": "8.41.0",
