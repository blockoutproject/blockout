{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/mobile",
  "projectType": "application",
  "sourceRoot": "apps/frontend/mobile/src",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/contracts",
          "target": "generate-openapi-bundles"
        }
      ],
      "outputs": ["{projectRoot}/src/shared/generated"],
      "options": {
        "command": "orval --config apps/frontend/mobile/orval.config.ts"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "expo install"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "expo prebuild"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "npm run lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "npm test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "tsc --noEmit --pretty false"
      }
    },
    "web-export": {
      "executor": "nx:run-commands",
      "dependsOn": ["codegen"],
      "outputs": ["{workspaceRoot}/dist/apps/frontend/mobile/web"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "npm run web:export"
      }
    }
  },
  "tags": ["scope:frontend", "type:application"]
}
