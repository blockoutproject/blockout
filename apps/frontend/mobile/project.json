{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/mobile",
  "projectType": "application",
  "sourceRoot": "apps/frontend/mobile/src",
  "implicitDependencies": ["@blockout/contracts"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "expo start --dev-client"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/orval.config.ts",
        "{projectRoot}/src/shared/api/orval-fetch.ts",
        "^contractSources",
        {
          "externalDependencies": ["orval"]
        }
      ],
      "dependsOn": [
        {
          "projects": "@blockout/contracts",
          "target": "prepare-consumers"
        }
      ],
      "outputs": ["{projectRoot}/src/shared/generated"],
      "options": {
        "command": "orval --config apps/frontend/mobile/orval.config.ts"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "expo install"
      }
    },
    "prebuild": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "expo prebuild"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^contractSources",
        {
          "externalDependencies": ["eslint", "eslint-config-expo", "orval"]
        }
      ],
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "npm run lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^contractSources",
        {
          "externalDependencies": ["jest", "jest-expo", "orval"]
        }
      ],
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "npm test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^contractSources",
        {
          "externalDependencies": ["orval", "typescript"]
        }
      ],
      "dependsOn": ["codegen"],
      "options": {
        "cwd": "apps/frontend/mobile",
        "command": "tsc --noEmit --pretty false"
      }
    },
    "export": {
      "dependsOn": ["codegen"]
    },
    "verify": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": ["lint", "typecheck", "test", "export"]
    }
  },
  "tags": ["scope:frontend", "type:application"]
}
