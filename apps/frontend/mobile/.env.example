# Authentication
# Auth0 client IDs and audiences are public identifiers. Never add a client secret to an Expo environment.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Local backend APIs
# Replace localhost with the host machine address when using a physical device.
EXPO_PUBLIC_API_GATEWAY_BASE_URL=
EXPO_PUBLIC_API_MATCHES_BASE_URL=
EXPO_PUBLIC_API_POOLS_BASE_URL=
EXPO_PUBLIC_API_TEAMS_BASE_URL=
EXPO_PUBLIC_API_COMPETITIONS_BASE_URL=
EXPO_PUBLIC_API_USERS_BASE_URL=
EXPO_PUBLIC_API_SEARCH_BASE_URL=
EXPO_PUBLIC_API_CONFIG_BASE_URL=
EXPO_PUBLIC_API_CLUBS_BASE_URL=
EXPO_PUBLIC_API_REPORTS_BASE_URL=
EXPO_PUBLIC_API_NOTIFICATIONS_BASE_URL=

# Public application integrations
EXPO_PUBLIC_MAP_URL=
EXPO_PUBLIC_INSTAGRAM_URL=
EXPO_PUBLIC_ENTITLEMENT_BLOCKOUT_PRO=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Google Mobile Ads uses official test inventory outside the EAS production profile.
EXPO_PUBLIC_ADS_ENVIRONMENT=
EXPO_PUBLIC_ADS_INTERSTITIAL_NAV_ANDROID=
EXPO_PUBLIC_ADS_INTERSTITIAL_WEB_ANDROID=
EXPO_PUBLIC_ADS_INTERSTITIAL_NAV_IOS=
EXPO_PUBLIC_ADS_INTERSTITIAL_WEB_IOS=
