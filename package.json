{
  "name": "blockout",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.0.1",
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:contracts": "redocly lint --config .redocly.yaml",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "verify": "npm run format:check && nx run-many -t verify --output-style=static",
    "bundle:contracts": "npm run lint:contracts && redocly bundle --config .redocly.yaml --dereferenced",
    "generate": "nx run-many -t generate --output-style=static"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.62.1",
    "nx": "23.3.0",
    "prettier": "3.9.6"
  }
}
