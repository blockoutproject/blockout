{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/python-contract-clients",
  "projectType": "library",
  "sourceRoot": "libs/shared/python-contract-clients/src",
  "targets": {
    "generate": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/contracts",
          "target": "generate-openapi-bundles"
        }
      ],
      "options": {
        "command": "openapi-generator-cli batch --clean --fail-fast libs/shared/python-contract-clients/openapi-generator.json"
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {
        "args": "--locked --all-packages"
      }
    },
    "build": {
      "executor": "@nxlv/python:build",
      "dependsOn": ["generate"],
      "outputs": ["{workspaceRoot}/dist/libs/shared/python-contract-clients"],
      "options": {
        "outputPath": "dist/libs/shared/python-contract-clients",
        "format": "wheel",
        "lockedVersions": true,
        "bundleLocalDependencies": true
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "python -c \"from blockout_contract_clients.shared.models import FormatEnum, GenderEnum; assert FormatEnum.SIX.value == 'SIX'; assert GenderEnum.F.value == 'F'\""
      }
    }
  },
  "tags": ["scope:shared", "type:library", "language:python"]
}
