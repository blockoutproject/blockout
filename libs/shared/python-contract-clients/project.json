{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@blockout/python-contract-clients",
  "projectType": "library",
  "sourceRoot": "libs/shared/python-contract-clients/src",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "@blockout/contracts",
          "target": "generate-openapi-bundles"
        }
      ],
      "options": {
        "parallel": false,
        "commands": [
          "uv run --locked --no-sync openapi-generator-cli batch --clean --fail-fast libs/shared/python-contract-clients/openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/club-openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/config-openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/team-openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/pool-openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/competition-openapi-generator.json",
          "uv run --locked --no-sync openapi-generator-cli batch --fail-fast libs/shared/python-contract-clients/match-openapi-generator.json"
        ]
      }
    },
    "build": {
      "executor": "@nxlv/python:build",
      "dependsOn": ["generate"],
      "outputs": ["{workspaceRoot}/dist/libs/shared/python-contract-clients"],
      "options": {
        "outputPath": "dist/libs/shared/python-contract-clients",
        "format": "wheel",
        "lockedVersions": true,
        "bundleLocalDependencies": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "uv run --locked --no-sync python -m pytest -q libs/shared/python-contract-clients/tests"
      }
    }
  },
  "tags": ["scope:shared", "type:library", "language:python"]
}
