{
  "name": "@blockout/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "inputs": [
          "contractSources",
          "{projectRoot}/specs/scripts/bundle-openapi.test.mjs"
        ],
        "options": {
          "command": "node --test libs/shared/contracts/specs/scripts/bundle-openapi.test.mjs"
        }
      },
      "generate-openapi-bundles": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "contractSources"
        ],
        "outputs": [
          "{projectRoot}/generated/specs/*.json"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/bundle-openapi.mjs"
        }
      },
      "sync-backend-schema-mappings": {
        "executor": "nx:run-commands",
        "inputs": [
          "backendSchemaMappings"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/sync-backend-schema-mappings.mjs"
        }
      },
      "generate-contracts": {
        "dependsOn": [
          {
            "target": "generate-openapi-bundles"
          },
          {
            "target": "sync-backend-schema-mappings"
          }
        ]
      },
      "prepare-consumers": {
        "executor": "nx:run-commands",
        "dependsOn": [
          {
            "target": "test"
          },
          {
            "target": "generate-contracts"
          }
        ],
        "options": {
          "command": "git diff --exit-code -- apps/backend/pom.xml"
        }
      }
    }
  }
}
