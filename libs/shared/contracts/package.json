{
  "name": "@blockout/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test libs/shared/contracts/specs/scripts/bundle-openapi.test.mjs libs/shared/contracts/specs/scripts/lint-openapi-source.test.mjs libs/shared/contracts/specs/scripts/sync-backend-schema-mappings.test.mjs"
        }
      },
      "lint-openapi-source": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/specs/source/**/*.json",
          "{projectRoot}/specs/lint-exceptions.json",
          "{projectRoot}/specs/scripts/lint-openapi-source.mjs"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/lint-openapi-source.mjs"
        }
      },
      "generate-openapi-bundles": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/specs/source/**/*.json",
          "{projectRoot}/specs/scripts/bundle-openapi.mjs"
        ],
        "outputs": [
          "{projectRoot}/generated/specs/*.json"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/bundle-openapi.mjs"
        }
      },
      "sync-backend-schema-mappings": {
        "executor": "nx:run-commands",
        "cache": false,
        "inputs": [
          "{projectRoot}/specs/source/shared/schemas/**/*.json",
          "{projectRoot}/specs/scripts/sync-backend-schema-mappings.mjs",
          "{workspaceRoot}/apps/backend/pom.xml"
        ],
        "outputs": [
          "{workspaceRoot}/apps/backend/pom.xml"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/sync-backend-schema-mappings.mjs"
        }
      },
      "generate-contracts": {
        "executor": "nx:noop",
        "outputs": [
          "{projectRoot}/generated/specs/*.json",
          "{workspaceRoot}/apps/backend/pom.xml"
        ],
        "dependsOn": [
          {
            "target": "generate-openapi-bundles"
          },
          {
            "target": "sync-backend-schema-mappings"
          }
        ]
      },
      "generate-event-bundles": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/events/source/**/*.json",
          "{projectRoot}/events/scripts/bundle-events.mjs",
          "{projectRoot}/events/scripts/event-contract-utils.mjs",
          "{workspaceRoot}/package-lock.json"
        ],
        "outputs": [
          "{projectRoot}/generated/events/*.json"
        ],
        "options": {
          "command": "node libs/shared/contracts/events/scripts/bundle-events.mjs"
        }
      },
      "generate-event-models": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          {
            "target": "generate-event-bundles"
          }
        ],
        "inputs": [
          "{projectRoot}/events/source/**/*.json",
          "{projectRoot}/events/scripts/generate-java-events.mjs",
          "{projectRoot}/events/scripts/event-contract-utils.mjs",
          "{workspaceRoot}/package-lock.json"
        ],
        "outputs": [
          "{workspaceRoot}/apps/backend/event-contracts/src/generated/java/**"
        ],
        "options": {
          "command": "node libs/shared/contracts/events/scripts/generate-java-events.mjs"
        }
      },
      "generate-event-contracts": {
        "executor": "nx:noop",
        "outputs": [
          "{projectRoot}/generated/events/*.json",
          "{workspaceRoot}/apps/backend/event-contracts/src/generated/java/**"
        ],
        "dependsOn": [
          {
            "target": "generate-event-models"
          }
        ]
      },
      "test-event-contracts": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "target": "generate-event-contracts"
          }
        ],
        "options": {
          "command": "node --test libs/shared/contracts/events/scripts/event-contracts.test.mjs"
        }
      },
      "generate-python-clients": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/generated/specs/config.json",
          "{projectRoot}/generated/specs/shared.json",
          "{projectRoot}/generated/specs/clubs.json",
          "{projectRoot}/generated/specs/teams.json",
          "{projectRoot}/generated/specs/pools.json",
          "{projectRoot}/generated/specs/competition.json",
          "{projectRoot}/generated/specs/matches.json",
          "{projectRoot}/clients/python/config/*.json",
          "{projectRoot}/clients/python/scripts/generate-python-clients.mjs",
          "{workspaceRoot}/openapitools.json",
          "{workspaceRoot}/package-lock.json"
        ],
        "outputs": [
          "{projectRoot}/clients/python/src/**"
        ],
        "dependsOn": [
          {
            "target": "generate-openapi-bundles"
          }
        ],
        "options": {
          "command": "node libs/shared/contracts/clients/python/scripts/generate-python-clients.mjs"
        }
      }
    }
  }
}
