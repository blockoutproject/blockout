{
  "name": "@blockout/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "targets": {
      "generate-openapi-bundles": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/specs/source/**/*.json",
          "{projectRoot}/specs/scripts/bundle-openapi.mjs"
        ],
        "outputs": [
          "{projectRoot}/generated/specs/*.json"
        ],
        "options": {
          "command": "node libs/shared/contracts/specs/scripts/bundle-openapi.mjs"
        }
      }
    }
  }
}
