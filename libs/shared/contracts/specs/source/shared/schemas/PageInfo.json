{
  "PageInfo": {
    "type": "object",
    "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
    "required": ["page", "pageSize", "hasNext"],
    "properties": {
      "page": {
        "type": "integer",
        "minimum": 0
      },
      "pageSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "totalItems": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "hasNext": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
