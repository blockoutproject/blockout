          "name": "liveLinkId",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": { "204": { "description": "Approved" } }
    }
  },
  "/api/v1/matches/live-links/{liveLinkId}/reject": {
    "post": {
      "tags": ["MatchLiveLink"],
      "operationId": "rejectPendingLink",
      "parameters": [
        {
          "name": "liveLinkId",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": { "204": { "description": "Rejected" } }
    }
  },
  "/api/v1/matches/live-links/{liveLinkId}/reactivate": {
    "post": {
      "tags": ["MatchLiveLink"],
      "operationId": "reactivateLiveLink",
      "parameters": [
        {
          "name": "liveLinkId",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": { "204": { "description": "Reactivated" } }
    }
  },
  "/api/v1/matches/internal/test/{id}/emit-finished": {
    "post": {
      "tags": ["MatchTest"],
      "operationId": "emitFinishedById",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": { "202": { "description": "Accepted" } }
    }
  },
  "/api/v1/matches/internal/test/emit-finished": {
    "post": {
      "tags": ["MatchTest"],
      "operationId": "emitFinishedCustom",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MatchFinishedTestRequest"
            }
          }
        }
      },
      "responses": { "202": { "description": "Accepted" } }
    }
  }
}
