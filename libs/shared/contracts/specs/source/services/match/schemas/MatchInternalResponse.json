{
  "MatchInternalResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "matchCode",
      "leagueCode",
      "poolId",
      "teamIdA",
      "teamIdB",
      "matchDate",
      "season",
      "status",
      "active"
    ],
    "properties": {
      "id": { "type": "integer", "format": "int64" },
      "matchCode": { "type": "string" },
      "leagueCode": { "type": "string" },
      "poolId": { "type": "integer", "format": "int64" },
      "liveCode": { "type": "integer", "format": "int64", "nullable": true },
      "teamIdA": { "type": "integer", "format": "int64" },
      "teamIdB": { "type": "integer", "format": "int64" },
      "matchDate": { "type": "string", "format": "date-time" },
      "season": { "type": "string" },
      "set": { "type": "string", "nullable": true },
      "score": { "type": "string", "nullable": true },
      "status": { "$ref": "#/components/schemas/MatchStatusEnum" },
      "venue": { "type": "string", "nullable": true },
      "firstReferee": { "type": "string", "nullable": true },
      "secondReferee": { "type": "string", "nullable": true },
      "active": { "type": "boolean" },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "lastUpdate": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      },
      "liveUrl": { "type": "string", "nullable": true },
      "liveProvider": {
        "allOf": [{ "$ref": "#/components/schemas/LiveProviderEnum" }],
        "nullable": true
      },
      "liveOwnerAuth0Id": { "type": "string", "nullable": true }
    }
  }
}
