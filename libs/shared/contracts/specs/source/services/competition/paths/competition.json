{
  "/api/v2/competitions/pools/{poolId}/teams/{teamId}": {
    "parameters": [
      { "$ref": "#/components/parameters/PoolId" },
      { "$ref": "#/components/parameters/TeamId" }
    ],
    "post": {
      "operationId": "addOrReactivateCompetitionAssociation",
      "tags": ["CompetitionAssociations"],
      "summary": "Add or reactivate a team in a pool",
      "description": "Creates a zero-stat association or reactivates the existing association while preserving its statistics and stored club identity. The caller must hold both listed scopes.",
      "parameters": [{ "$ref": "#/components/parameters/AssociationClubId" }],
      "responses": {
        "200": {
          "description": "Created, existing, or reactivated association.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionAssociationInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/pools/{poolId}/teams": {
    "parameters": [{ "$ref": "#/components/parameters/PoolId" }],
    "get": {
      "operationId": "listCompetitionAssociationsByPool",
      "tags": ["CompetitionAssociations"],
      "summary": "List active associations for a pool",
      "description": "Returns active associations ordered by teamId ascending. Compatibility callers aggregate all pages and retain the legacy empty-array behavior.",
      "parameters": [
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested association page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionAssociationInternalPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/teams/{teamId}/pools": {
    "parameters": [{ "$ref": "#/components/parameters/TeamId" }],
    "get": {
      "operationId": "listCompetitionAssociationsByTeam",
      "tags": ["CompetitionAssociations"],
      "summary": "List active associations for a team",
      "description": "Returns active associations ordered by poolId ascending. Compatibility callers aggregate all pages and retain the legacy empty-array behavior.",
      "parameters": [
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested association page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionAssociationInternalPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/pools/{poolId}/teams/bulk-deactivate": {
    "parameters": [{ "$ref": "#/components/parameters/PoolId" }],
    "put": {
      "operationId": "bulkDeactivateCompetitionTeamsByPool",
      "tags": ["CompetitionLifecycle"],
      "summary": "Deactivate missing teams in a pool",
      "description": "Deactivates active associations for the supplied missingTeamIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MissingTeamIdsInternalRequest"
            }
          }
        }
      },
      "responses": {
        "204": { "description": "Lifecycle command completed." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/pools/bulk-deactivate": {
    "put": {
      "operationId": "bulkDeactivateCompetitionPools",
      "tags": ["CompetitionLifecycle"],
      "summary": "Deactivate missing pools",
      "description": "Deactivates active associations for the supplied missingPoolIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MissingPoolIdsInternalRequest"
            }
          }
        }
      },
      "responses": {
        "204": { "description": "Lifecycle command completed." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/clubs/bulk-deactivate": {
    "put": {
      "operationId": "bulkDeactivateCompetitionClubs",
      "tags": ["CompetitionLifecycle"],
      "summary": "Deactivate missing clubs",
      "description": "Deactivates active associations for the supplied missingClubIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MissingClubIdsInternalRequest"
            }
          }
        }
      },
      "responses": {
        "204": { "description": "Lifecycle command completed." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/pools/{poolId}/teams/{teamId}/stats": {
    "parameters": [
      { "$ref": "#/components/parameters/PoolId" },
      { "$ref": "#/components/parameters/TeamId" }
    ],
    "put": {
      "operationId": "replaceCompetitionStatistics",
      "tags": ["CompetitionStatistics"],
      "summary": "Replace association statistics",
      "description": "Atomically replaces all seventeen statistics for the identified association. Partial snapshots and null statistics are invalid.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CompetitionStatisticsSnapshotInternalRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated association snapshot.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionAssociationInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/competitions/teams/{teamId}/pools-with-ranking": {
    "parameters": [{ "$ref": "#/components/parameters/TeamId" }],
    "get": {
      "operationId": "listPoolRankingsByTeam",
      "tags": ["CompetitionRankings"],
      "summary": "List pool rankings for a team",
      "description": "Returns pool groups ordered by poolId ascending. Each complete ranking is ordered by points descending, pointsPenalty ascending, wins descending, coefSets descending, coefPoints descending, then teamId ascending as a deterministic technical tie-breaker. Empty results return an empty page.",
      "parameters": [
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested pool-ranking page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoolRankingInternalPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  }
}
