{
  "CompetitionAssociationInternalResponse": {
    "type": "object",
    "description": "Competition-owned association and full statistics snapshot without persistence identity or audit timestamps.",
    "required": [
      "poolId",
      "teamId",
      "clubId",
      "active",
      "points",
      "played",
      "wins",
      "losses",
      "winsThreeToZero",
      "winsThreeToOne",
      "winsThreeToTwo",
      "lossesZeroToThree",
      "lossesOneToThree",
      "lossesTwoToThree",
      "wonSets",
      "lostSets",
      "wonPoints",
      "lostPoints",
      "pointsPenalty",
      "coefSets",
      "coefPoints"
    ],
    "properties": {
      "poolId": { "$ref": "#/components/schemas/NumericIdentifier" },
      "teamId": { "$ref": "#/components/schemas/NumericIdentifier" },
      "clubId": { "type": "string", "maxLength": 255 },
      "active": { "type": "boolean" },
      "points": { "type": "integer", "format": "int32" },
      "played": { "type": "integer", "format": "int32" },
      "wins": { "type": "integer", "format": "int32" },
      "losses": { "type": "integer", "format": "int32" },
      "winsThreeToZero": { "type": "integer", "format": "int32" },
      "winsThreeToOne": { "type": "integer", "format": "int32" },
      "winsThreeToTwo": { "type": "integer", "format": "int32" },
      "lossesZeroToThree": { "type": "integer", "format": "int32" },
      "lossesOneToThree": { "type": "integer", "format": "int32" },
      "lossesTwoToThree": { "type": "integer", "format": "int32" },
      "wonSets": { "type": "integer", "format": "int32" },
      "lostSets": { "type": "integer", "format": "int32" },
      "wonPoints": { "type": "integer", "format": "int32" },
      "lostPoints": { "type": "integer", "format": "int32" },
      "pointsPenalty": { "type": "integer", "format": "int32" },
      "coefSets": { "type": "number", "format": "double" },
      "coefPoints": { "type": "number", "format": "double" }
    },
    "additionalProperties": false
  }
}
