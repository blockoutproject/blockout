{
  "/api/v2/users/me": {
    "post": {
      "operationId": "ensureCurrentUser",
      "tags": ["CurrentUser"],
      "description": "Create the authenticated canonical user once. Accepts no caller-selected identity or profile body. Repeated and concurrent requests return the existing profile.",
      "responses": {
        "200": {
          "description": "Existing profile",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileResponse"
              }
            }
          }
        },
        "201": {
          "description": "Created profile",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileResponse"
              }
            }
          },
          "headers": {
            "Location": {
              "description": "Current profile resource",
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "403": {
          "description": "User identity required or profile inactive",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "404": {
          "description": "Profile not found",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "409": {
          "description": "Unsupported or mismatched identity",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "503": {
          "description": "Identity provider temporarily unavailable",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        }
      }
    },
    "get": {
      "operationId": "getCurrentUser",
      "tags": ["CurrentUser"],
      "description": "Read the current profile without provider calls or implicit creation.",
      "responses": {
        "200": {
          "description": "Current profile",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfileResponse"
              }
            }
          }
        },
        "401": {
          "description": "Authentication required",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "403": {
          "description": "User identity required or profile inactive",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "404": {
          "description": "Profile not found",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "409": {
          "description": "Unsupported or mismatched identity",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        },
        "503": {
          "description": "Identity provider temporarily unavailable",
          "content": {
            "application/problem+json": {
              "schema": {
                "$ref": "#/components/schemas/ProblemDetail"
              }
            }
          }
        }
      }
    }
  }
}
