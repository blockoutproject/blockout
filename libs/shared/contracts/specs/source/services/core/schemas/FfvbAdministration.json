{
  "FfvbConfigurationRequest": {
    "type": "object",
    "required": ["enabled", "season", "sources"],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "season": {
        "type": "string",
        "pattern": "^\\d{4}/\\d{4}$",
        "nullable": true
      },
      "sources": {
        "type": "array",
        "maxItems": 256,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,16}$"
        }
      }
    }
  },
  "FfvbConfigurationResponse": {
    "type": "object",
    "required": ["enabled", "season", "sources", "updatedAt"],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "season": {
        "type": "string",
        "pattern": "^\\d{4}/\\d{4}$",
        "nullable": true
      },
      "sources": {
        "type": "array",
        "maxItems": 256,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,16}$"
        }
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "nullable": true
      }
    }
  },
  "DivisionRequest": {
    "type": "object",
    "required": ["name", "active"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": ".*\\S.*"
      },
      "active": {
        "type": "boolean"
      }
    }
  },
  "DivisionResponse": {
    "type": "object",
    "required": ["id", "name", "active"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "active": {
        "type": "boolean"
      }
    }
  },
  "FfvbMappingRequest": {
    "type": "object",
    "required": ["divisionId", "format", "gender"],
    "properties": {
      "divisionId": {
        "type": "string",
        "format": "uuid"
      },
      "format": {
        "$ref": "#/components/schemas/FormatEnum"
      },
      "gender": {
        "$ref": "#/components/schemas/GenderEnum"
      }
    }
  },
  "FfvbMappingResponse": {
    "type": "object",
    "required": ["id", "organizer", "label", "divisionId", "format", "gender"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "organizer": {
        "type": "string",
        "pattern": "^[A-Z0-9]{2,16}$"
      },
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "divisionId": {
        "type": "string",
        "format": "uuid",
        "nullable": true
      },
      "format": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FormatEnum"
          }
        ],
        "nullable": true
      },
      "gender": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GenderEnum"
          }
        ],
        "nullable": true
      }
    }
  },
  "SportsPageInfo": {
    "type": "object",
    "required": ["page", "pageSize", "hasNext"],
    "properties": {
      "page": {
        "type": "integer"
      },
      "pageSize": {
        "type": "integer"
      },
      "hasNext": {
        "type": "boolean"
      }
    }
  },
  "DivisionPage": {
    "type": "object",
    "required": ["items", "pageInfo"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DivisionResponse"
        }
      },
      "pageInfo": {
        "$ref": "#/components/schemas/SportsPageInfo"
      }
    }
  },
  "FfvbMappingPage": {
    "type": "object",
    "required": ["items", "pageInfo"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FfvbMappingResponse"
        }
      },
      "pageInfo": {
        "$ref": "#/components/schemas/SportsPageInfo"
      }
    }
  }
}
