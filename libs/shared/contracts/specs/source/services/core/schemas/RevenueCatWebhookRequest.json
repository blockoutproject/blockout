        "maxLength": 100
      },
      "event_timestamp_ms": {
        "type": "integer",
        "format": "int64"
      },
      "environment": {
        "type": "string",
        "nullable": true
      },
      "app_user_id": {
        "type": "string",
        "nullable": true
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "transferred_from": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "transferred_to": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
