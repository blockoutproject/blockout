{
  "ProblemDetail": {
    "type": "object",
    "required": ["title", "status", "detail", "code"],
    "properties": {
      "type": {
        "type": "string",
        "format": "uri",
        "description": "Problem type URI; omission means about:blank under RFC 9457."
      },
      "title": {
        "type": "string"
      },
      "status": {
        "type": "integer"
      },
      "detail": {
        "type": "string"
      },
      "code": {
        "$ref": "#/components/schemas/ApiProblemCodeEnum"
      },
      "instance": {
        "type": "string",
        "description": "Optional URI reference identifying this occurrence, as defined by RFC 9457."
      }
    }
  }
}
