      "leagueCode": { "type": "string" },
      "season": { "type": "string" },
      "leagueName": { "type": "string" },
      "rawName": { "type": "string" },
      "name": { "type": "string" },
      "shortName": { "type": "string" },
      "divisionId": { "type": "integer", "format": "int64" },
