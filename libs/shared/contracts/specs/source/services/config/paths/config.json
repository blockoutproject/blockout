{
  "/api/v1/config/app-status": {
    "get": {
      "tags": ["AppStatus"],
      "operationId": "getAppStatus",
      "summary": "Get the application status",
      "responses": {
        "200": {
          "description": "Application status returned",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppStatusInternalResponse"
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" }
      }
    },
    "put": {
      "tags": ["AppStatus"],
      "operationId": "updateAppStatus",
      "summary": "Update the application status",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateAppStatusInternalRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Application status updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppStatusInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequest" },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" }
      }
    }
  },
  "/api/v1/config/divisions": {
    "get": {
      "tags": ["Division"],
      "operationId": "listDivisions",
      "summary": "List active and inactive Divisions",
      "responses": {
        "200": {
          "description": "Divisions returned",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DivisionInternalResponse"
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" }
      }
    },
    "post": {
      "tags": ["Division"],
      "operationId": "createDivision",
      "summary": "Create a Division from multipart JSON and an optional image",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": { "type": "string" },
                "image": { "type": "string", "format": "binary" }
              }
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Division created",
          "headers": {
            "Location": {
              "description": "URI of the created Division",
              "schema": { "type": "string", "format": "uri" }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DivisionInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequest" },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" }
      }
    }
  },
  "/api/v1/config/divisions/{id}": {
    "parameters": [
      {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "format": "int64" }
      }
    ],
    "get": {
      "tags": ["Division"],
      "operationId": "getDivisionById",
      "summary": "Get a Division by identifier",
      "responses": {
        "200": {
          "description": "Division returned",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DivisionInternalResponse"
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" },
        "404": { "$ref": "#/components/responses/NotFound" }
      }
    },
    "put": {
      "tags": ["Division"],
      "operationId": "updateDivision",
      "summary": "Update and, when necessary, reactivate a Division",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": { "type": "string" },
                "image": { "type": "string", "format": "binary" }
              }
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Division updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DivisionInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequest" },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" },
        "404": { "$ref": "#/components/responses/NotFound" }
      }
    },
    "delete": {
      "tags": ["Division"],
      "operationId": "deactivateDivision",
      "summary": "Deactivate a Division",
      "responses": {
        "204": { "description": "Division deactivated" },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "403": { "$ref": "#/components/responses/Forbidden" },
        "404": { "$ref": "#/components/responses/NotFound" }
      }
    }
  },
