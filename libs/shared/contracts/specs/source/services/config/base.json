{
  "openapi": "3.0.3",
  "info": {
    "title": "Config Service Internal API",
    "version": "1.0.0"
  },
  "servers": [{ "url": "http://localhost:8090" }],
  "tags": [
    { "name": "AppStatus" },
    { "name": "Division" },
    { "name": "LegalDocument" },
