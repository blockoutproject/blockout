{
  "CreateRawDivisionMappingInternalRequest": {
    "type": "object",
    "description": "Creates a raw federation division mapping. Persistence identity and audit fields are service-owned; mapping fields may be absent or null until an administrator resolves them.",
    "required": ["rawDivisionName", "leagueCode", "season"],
    "properties": {
      "rawDivisionName": {
        "type": "string",
        "maxLength": 255
      },
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "nullable": true
      },
      "format": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FormatEnum"
          }
        ],
        "nullable": true
      },
      "gender": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GenderEnum"
          }
        ],
        "nullable": true
      },
      "leagueCode": {
        "type": "string",
        "maxLength": 255
      },
      "season": {
        "type": "string",
        "maxLength": 255
      }
    },
    "additionalProperties": false
  }
}
