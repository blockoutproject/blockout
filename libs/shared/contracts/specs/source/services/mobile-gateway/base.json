{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Mobile Gateway API",
    "version": "2.0.0"
  },
  "servers": [{ "url": "http://localhost" }],
  "tags": [
    { "name": "MobileConfiguration" },
    { "name": "MobileLegalDocuments" },
    { "name": "MobileUsers" },
    { "name": "MobileReports" },
    { "name": "MobileSearch" },
    { "name": "MobileNotifications" },
    { "name": "MobileClubs" },
    { "name": "MobileTeams" },
    { "name": "MobilePools" },
    { "name": "MobileMatches" },
    { "name": "MobileMatchLiveLinks" },
    { "name": "MobileMatchModeration" },
    { "name": "MobileFederationDocuments" }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "parameters": {
      "MobileDivisionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileLegalDocumentType": {
        "name": "type",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "maxLength": 50 }
      },
      "MobileRawDivisionMappingId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileLeagueCode": {
        "name": "leagueCode",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "maxLength": 255 }
      },
      "MobileSeason": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "maxLength": 255 }
      },
      "MobileScraperName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ScraperNameEnum" }
      },
      "MobileScraperEnabled": {
        "name": "enabled",
        "in": "query",
        "required": true,
        "schema": { "type": "boolean" }
      },
      "MobileAuth0Id": {
        "name": "auth0Id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "MobileFavoriteEntityType": {
        "name": "entityType",
        "in": "query",
        "required": true,
        "schema": { "$ref": "#/components/schemas/EntityTypeEnum" }
      },
      "MobileFavoriteEntityId": {
        "name": "entityId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileSearchQuery": {
        "name": "query",
        "in": "query",
        "required": true,
        "description": "Search text. Blank input intentionally selects random examples.",
        "schema": { "type": "string" }
      },
      "MobileSearchDivisionId": {
        "name": "divisionId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileSearchFormat": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/FormatEnum" }
      },
      "MobileSearchGender": {
        "name": "gender",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/GenderEnum" }
      },
      "MobileNotificationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileUserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/UuidIdentifier" }
      },
      "MobileClubId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "MobileClubIdForTeams": {
        "name": "clubId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "MobileTeamId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobilePoolId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileIds": {
        "name": "ids",
        "in": "query",
        "required": true,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "MobileMatchId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileLiveMatchId": {
        "name": "matchId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileLiveLinkId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "MobileMatchPoolIds": {
        "name": "poolIds",
        "in": "query",
        "required": false,
        "description": "Optional set-like pool filter. Pool and team filters retain the current downstream OR semantics.",
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "MobileMatchTeamIds": {
        "name": "teamIds",
        "in": "query",
        "required": false,
        "description": "Optional set-like team filter. Pool and team filters retain the current downstream OR semantics.",
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "MobileMatchStatus": {
        "name": "status",
        "in": "query",
        "required": true,
        "schema": { "$ref": "#/components/schemas/MatchStatusEnum" }
      },
      "MobileMatchDayPageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Number of distinct Paris-local match dates requested, not a bound on match rows or enrichment fan-out.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 4
        }
      },
      "MobileLiveLinkStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/LiveLinkStatusEnum" }
      },
      "MobileFederationPdfToken": {
        "name": "token",
        "in": "path",
        "required": true,
        "description": "Short-lived signed continuation token generated by the mobile match-detail workflow.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "responses": {
      "MobileFederationBadGatewayProblem": {
        "description": "The federation document provider could not complete the proxied request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetail" }
          }
        }
      }
    }
  }
}
