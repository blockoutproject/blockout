{
  "/api/v2/mobile/secure/users/{auth0Id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileAuth0Id" }],
    "put": {
      "operationId": "updateMobileUser",
      "tags": ["MobileUsers"],
      "summary": "Update the mobile user profile",
      "description": "Preserves the existing path-subject workflow without claiming an authorization correction. The multipart command uses explicit picture-removal intent.",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/UpdateMobileUserRequest"
                },
                "image": { "type": "string", "format": "binary" }
              },
              "additionalProperties": false
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile user.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileUser" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "413": { "$ref": "#/components/responses/PayloadTooLargeProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/users/me": {
    "put": {
      "operationId": "ensureCurrentMobileUser",
      "tags": ["MobileUsers"],
      "summary": "Ensure the current mobile user",
      "responses": {
        "200": {
          "description": "Current mobile user.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileUser" }
            }
          }
        },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    },
    "delete": {
      "operationId": "deleteCurrentMobileUser",
      "tags": ["MobileUsers"],
      "summary": "Delete the current mobile user",
      "description": "Preserves the current downstream deletion orchestration. Client sign-out and cross-service cleanup corrections remain later work.",
      "responses": {
        "204": { "description": "Current mobile user deleted." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/favorites/follow": {
    "post": {
      "operationId": "followMobileEntity",
      "tags": ["MobileUsers"],
      "summary": "Follow a mobile team or pool",
      "parameters": [
        { "$ref": "#/components/parameters/MobileFavoriteEntityType" },
        { "$ref": "#/components/parameters/MobileFavoriteEntityId" }
      ],
      "responses": {
        "204": { "description": "Favorite present or already present." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    },
    "delete": {
      "operationId": "unfollowMobileEntity",
      "tags": ["MobileUsers"],
      "summary": "Unfollow a mobile team or pool",
      "parameters": [
        { "$ref": "#/components/parameters/MobileFavoriteEntityType" },
        { "$ref": "#/components/parameters/MobileFavoriteEntityId" }
      ],
      "responses": {
        "204": { "description": "Favorite absent or removed." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  }
}
