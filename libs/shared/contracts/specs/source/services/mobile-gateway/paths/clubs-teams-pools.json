{
  "/api/v2/mobile/public/clubs/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileClubId" }],
    "get": {
      "operationId": "getMobileClub",
      "tags": ["MobileClubs"],
      "summary": "Get a mobile club profile",
      "description": "Returns the consumer-backed club profile. Address is restored from the owner projection, while phone number is intentionally excluded by the BFF privacy policy.",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested mobile club profile.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileClubDetail" }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/clubs/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileClubId" }],
    "put": {
      "operationId": "updateMobileClub",
      "tags": ["MobileClubs"],
      "summary": "Update a mobile club profile",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/UpdateMobileClubRequest"
                },
                "image": { "type": "string", "format": "binary" }
              },
              "additionalProperties": false
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile club profile.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileClubDetail" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "413": { "$ref": "#/components/responses/PayloadTooLargeProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/teams/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileTeamId" }],
    "get": {
      "operationId": "getMobileTeam",
      "tags": ["MobileTeams"],
      "summary": "Get an enriched mobile team",
      "description": "Builds the team screen projection. A missing required team, division, pool, or ranking team fails the whole request; no partial detail is returned.",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested enriched mobile team.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileTeamDetail" }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/teams/by-club/{clubId}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileClubIdForTeams" }],
    "get": {
      "operationId": "listMobileTeamsByClub",
      "tags": ["MobileTeams"],
      "summary": "List active mobile teams for a club",
      "description": "Preserves downstream active-team order, which has no stable guarantee. Missing divisions remain explicit nulls; a missing club is tolerated only when every team already has a logo.",
      "security": [],
      "responses": {
        "200": {
          "description": "Bounded mobile team list in current downstream order.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileTeamListResponse"
              }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/teams/by-ids": {
    "get": {
      "operationId": "listMobileTeamsByIds",
      "tags": ["MobileTeams"],
      "summary": "List selected mobile teams",
      "description": "Deduplicates identifiers, silently omits missing or inactive teams, and preserves the current unspecified set-derived order. Missing divisions and clubs remain nullable enrichment results; the response carries no partial-result marker.",
      "security": [],
      "parameters": [{ "$ref": "#/components/parameters/MobileIds" }],
      "responses": {
        "200": {
          "description": "Selected active teams; an empty items array also represents all identifiers missing or inactive.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileTeamListResponse"
              }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/teams/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileTeamId" }],
    "put": {
      "operationId": "updateMobileTeam",
      "tags": ["MobileTeams"],
      "summary": "Update a mobile team",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/UpdateMobileTeamRequest"
                },
                "image": { "type": "string", "format": "binary" }
              },
              "additionalProperties": false
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile team fields used by the edit workflow.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileTeamUpdated" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "413": { "$ref": "#/components/responses/PayloadTooLargeProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/pools/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobilePoolId" }],
    "get": {
      "operationId": "getMobilePool",
      "tags": ["MobilePools"],
      "summary": "Get an enriched mobile pool",
      "description": "Builds the pool screen and ranking projection. Inactive pools remain readable; a missing required pool, division, or ranking team fails the whole request.",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested enriched mobile pool.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobilePoolDetail" }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/pools/by-ids": {
    "get": {
      "operationId": "listMobilePoolsByIds",
      "tags": ["MobilePools"],
      "summary": "List selected mobile pools",
      "description": "Deduplicates identifiers, silently omits missing or inactive pools, and preserves the current unspecified set-derived order. Missing divisions remain explicit nulls and the response carries no partial-result marker.",
      "security": [],
      "parameters": [{ "$ref": "#/components/parameters/MobileIds" }],
      "responses": {
        "200": {
          "description": "Selected active pools; an empty items array also represents all identifiers missing or inactive.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobilePoolListResponse"
              }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/pools/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobilePoolId" }],
    "put": {
      "operationId": "updateMobilePool",
      "tags": ["MobilePools"],
      "summary": "Update a mobile pool",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/UpdateMobilePoolRequest" }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile pool fields used by the edit workflow.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobilePoolUpdated" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  }
}
