{
  "/api/v1/mobile/public/ffvb/pdf/{token}": {
    "get": {
      "tags": ["FfvbPublic"],
      "operationId": "proxySignedFfvbPdf",
      "security": [],
      "parameters": [
        {
          "name": "token",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "PDF document",
          "content": {
            "application/pdf": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "400": { "description": "Invalid document kind" },
        "401": { "description": "Invalid or expired link" },
        "502": { "description": "Upstream error" }
      }
    }
  }
}
