{
  "/api/v2/mobile/public/config/app-status": {
    "get": {
      "operationId": "getMobileAppStatus",
      "tags": ["MobileConfiguration"],
      "summary": "Get the mobile application status",
      "description": "Public relay of the current app-status projection. A missing downstream row and its nullable compatibility behavior remain isolated in the v1 adapter until the runtime migration proves parity.",
      "security": [],
      "responses": {
        "200": {
          "description": "Current mobile application status.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileAppStatus" }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/config/app-status": {
    "put": {
      "operationId": "updateMobileAppStatus",
      "tags": ["MobileConfiguration"],
      "summary": "Update the mobile application status",
      "description": "Authenticated mobile administration relay. Omitted or null properties preserve their stored values.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateMobileAppStatusRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile application status.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileAppStatus" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/config/divisions": {
    "get": {
      "operationId": "listMobileDivisions",
      "tags": ["MobileConfiguration"],
      "summary": "List active mobile divisions",
      "description": "Public bounded division catalog in downstream order. The v1 adapter preserves its raw-array wire.",
      "security": [],
      "responses": {
        "200": {
          "description": "Active mobile division list.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileDivisionListResponse"
              }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/config/divisions/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileDivisionId" }],
    "get": {
      "operationId": "getMobileDivision",
      "tags": ["MobileConfiguration"],
      "summary": "Get a mobile division",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested mobile division.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileDivision" }
            }
          }
        },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/config/divisions": {
    "post": {
      "operationId": "createMobileDivision",
      "tags": ["MobileConfiguration"],
      "summary": "Create a mobile division",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/CreateMobileDivisionRequest"
                },
                "image": { "type": "string", "format": "binary" }
              },
              "additionalProperties": false
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created mobile division.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileDivision" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "413": { "$ref": "#/components/responses/PayloadTooLargeProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/config/divisions/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileDivisionId" }],
    "put": {
      "operationId": "updateMobileDivision",
      "tags": ["MobileConfiguration"],
      "summary": "Update a mobile division",
      "requestBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["data"],
              "properties": {
                "data": {
                  "$ref": "#/components/schemas/UpdateMobileDivisionRequest"
                },
                "image": { "type": "string", "format": "binary" }
              },
              "additionalProperties": false
            },
            "encoding": { "data": { "contentType": "application/json" } }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated mobile division.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileDivision" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "413": { "$ref": "#/components/responses/PayloadTooLargeProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    },
    "delete": {
      "operationId": "deactivateMobileDivision",
      "tags": ["MobileConfiguration"],
      "summary": "Deactivate a mobile division",
      "responses": {
        "204": { "description": "Mobile division deactivated." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
