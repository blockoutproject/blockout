{
  "/api/v2/mobile/public/ffvb/pdf/{token}": {
    "parameters": [
      { "$ref": "#/components/parameters/MobileFederationPdfToken" }
    ],
    "get": {
      "operationId": "getMobileFederationPdf",
      "tags": ["MobileFederationDocuments"],
      "summary": "Continue to a signed federation PDF",
      "description": "Validates the short-lived BFF token and proxies the selected FFVB or LNV PDF without exposing vendor parameters as a public contract.",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested federation PDF.",
          "headers": {
            "Cache-Control": {
              "description": "Signed documents are never stored by clients or intermediaries.",
              "schema": { "type": "string", "pattern": "^no-store$" }
            }
          },
          "content": {
            "application/pdf": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "502": {
          "$ref": "#/components/responses/MobileFederationBadGatewayProblem"
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/matches": {
    "get": {
      "operationId": "listMobileMatchDays",
      "tags": ["MobileMatches"],
      "summary": "List enriched mobile match days",
      "description": "Pages distinct Paris-local dates, preserves status-dependent day, pool, and match order after silent catalog drops, and retains the audited terminal-empty continuation behavior.",
      "security": [],
      "parameters": [
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/MobileMatchDayPageSize" },
        { "$ref": "#/components/parameters/MobileMatchPoolIds" },
        { "$ref": "#/components/parameters/MobileMatchTeamIds" },
        { "$ref": "#/components/parameters/MobileMatchStatus" }
      ],
      "responses": {
        "200": {
          "description": "Requested enriched match-day page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileMatchDayPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/matches/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/MobileMatchId" }],
    "get": {
      "operationId": "getMobileMatch",
      "tags": ["MobileMatches"],
      "summary": "Get an enriched mobile match",
      "description": "Builds the screen-ready match, competition ranking, and signed-document projection. Missing required match, pool, division, side, ranking team, or signing input fails the whole request.",
      "security": [],
      "responses": {
        "200": {
          "description": "Requested enriched mobile match.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MobileMatchDetail" }
            }
          }
        },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/{matchId}/live-link": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveMatchId" }],
    "post": {
      "operationId": "upsertMobileMatchLiveLink",
      "tags": ["MobileMatchLiveLinks"],
      "summary": "Create or update a mobile match live link",
      "description": "Delegates provider, ownership, account-age, quota, timing, professional-league, and state decisions to matches-service.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpsertMobileMatchLiveLinkRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Current mobile live-link command result.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileMatchLiveLinkResult"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    },
    "delete": {
      "operationId": "deleteMobileMatchLiveLink",
      "tags": ["MobileMatchLiveLinks"],
      "summary": "Deactivate the active mobile match live link",
      "description": "Returns 204 when no active link exists and retains matches-service owner or moderator authorization.",
      "responses": {
        "204": { "description": "Active link deactivated or already absent." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/{matchId}/live-link/report": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveMatchId" }],
    "post": {
      "operationId": "reportMobileMatchLiveLink",
      "tags": ["MobileMatchLiveLinks"],
      "summary": "Report the active mobile match live link",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReportMobileMatchLiveLinkRequest"
            }
          }
        }
      },
      "responses": {
        "204": { "description": "Live-link report accepted." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/{matchId}/live-links": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveMatchId" }],
    "get": {
      "operationId": "listMobileMatchLiveLinkHistory",
      "tags": ["MobileMatchModeration"],
      "summary": "List mobile match live-link history",
      "description": "Returns newest-first history as a canonical page. An absent match remains indistinguishable from an existing match with no links; the v1 adapter aggregates all pages into its legacy array.",
      "parameters": [
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested mobile live-link history page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileMatchLiveLinkHistoryPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/live-moderation": {
    "get": {
      "operationId": "listMobileMatchesForLiveModeration",
      "tags": ["MobileMatchModeration"],
      "summary": "List enriched mobile matches for live moderation",
      "description": "Status filters historical existence while representative fields retain their independent priority selection. Missing catalog dependencies silently drop rows without omission metadata; the v1 adapter aggregates canonical pages.",
      "parameters": [
        { "$ref": "#/components/parameters/MobileLiveLinkStatus" },
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested enriched moderation page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileMatchModerationPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/live-links/{id}/approve": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveLinkId" }],
    "post": {
      "operationId": "approveMobileMatchLiveLink",
      "tags": ["MobileMatchModeration"],
      "summary": "Approve a pending mobile match live link",
      "responses": {
        "204": { "description": "Live link approved." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/live-links/{id}/reject": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveLinkId" }],
    "post": {
      "operationId": "rejectMobileMatchLiveLink",
      "tags": ["MobileMatchModeration"],
      "summary": "Reject a pending mobile match live link",
      "responses": {
        "204": { "description": "Live link rejected." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/secure/matches/live-links/{id}/reactivate": {
    "parameters": [{ "$ref": "#/components/parameters/MobileLiveLinkId" }],
    "post": {
      "operationId": "reactivateMobileMatchLiveLink",
      "tags": ["MobileMatchModeration"],
      "summary": "Reactivate an eligible mobile match live link",
      "responses": {
        "204": { "description": "Live link reactivated." },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  }
}
