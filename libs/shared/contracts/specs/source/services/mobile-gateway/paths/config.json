  "/api/v1/mobile/secure/config/scrapers/{name}/enabled": {
    "put": {
      "tags": ["ConfigSecure"],
      "operationId": "updateScraperStatus",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "name": "name",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "enabled",
          "in": "query",
          "required": true,
          "schema": { "type": "boolean" }
        }
      ],
      "responses": {
        "200": {
          "description": "Scraper status updated",
          "content": {
            "application/json": {
