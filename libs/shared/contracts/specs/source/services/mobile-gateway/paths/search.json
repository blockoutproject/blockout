{
  "/api/v2/mobile/public/search/clubs": {
    "get": {
      "operationId": "searchMobileClubs",
      "tags": ["MobileSearch"],
      "summary": "Search mobile clubs",
      "description": "Returns a bounded product projection. Empty results use an items wrapper; the v1 adapter preserves its current empty-to-204 behavior.",
      "security": [],
      "parameters": [{ "$ref": "#/components/parameters/MobileSearchQuery" }],
      "responses": {
        "200": {
          "description": "Bounded mobile club results.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileClubSearchListResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/search/teams": {
    "get": {
      "operationId": "searchMobileTeams",
      "tags": ["MobileSearch"],
      "summary": "Search mobile teams",
      "security": [],
      "parameters": [
        { "$ref": "#/components/parameters/MobileSearchQuery" },
        { "$ref": "#/components/parameters/MobileSeason" },
        { "$ref": "#/components/parameters/MobileSearchDivisionId" },
        { "$ref": "#/components/parameters/MobileSearchFormat" },
        { "$ref": "#/components/parameters/MobileSearchGender" }
      ],
      "responses": {
        "200": {
          "description": "Bounded mobile team results.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileTeamSearchListResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  },
  "/api/v2/mobile/public/search/pools": {
    "get": {
      "operationId": "searchMobilePools",
      "tags": ["MobileSearch"],
      "summary": "Search mobile pools",
      "security": [],
      "parameters": [
        { "$ref": "#/components/parameters/MobileSearchQuery" },
        { "$ref": "#/components/parameters/MobileSeason" },
        { "$ref": "#/components/parameters/MobileSearchDivisionId" },
        { "$ref": "#/components/parameters/MobileSearchFormat" },
        { "$ref": "#/components/parameters/MobileSearchGender" }
      ],
      "responses": {
        "200": {
          "description": "Bounded mobile pool results.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobilePoolSearchListResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "500": { "$ref": "#/components/responses/InternalServerErrorProblem" }
      }
    }
  }
}
