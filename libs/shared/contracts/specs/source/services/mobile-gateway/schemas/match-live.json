{
  "UpsertMobileMatchLiveLinkRequest": {
    "type": "object",
    "description": "Mobile live-link input. Provider and every policy decision remain server-owned.",
    "required": ["url"],
    "properties": {
      "url": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "additionalProperties": false
  },
  "MobileMatchLiveLinkResult": {
    "type": "object",
    "description": "Narrow command result retained for generated-client compatibility even though the current Expo mutation ignores its body.",
    "required": ["matchId", "provider", "url", "status"],
    "properties": {
      "matchId": { "$ref": "#/components/schemas/NumericIdentifier" },
      "provider": { "$ref": "#/components/schemas/LiveProviderEnum" },
      "url": { "type": "string", "maxLength": 1024 },
      "status": { "$ref": "#/components/schemas/LiveLinkStatusEnum" }
    },
    "additionalProperties": false
  },
  "ReportMobileMatchLiveLinkRequest": {
    "type": "object",
    "description": "Mobile report explanation using the current submitted-form constraints.",
    "required": ["reason"],
    "properties": {
      "reason": { "type": "string", "minLength": 10, "maxLength": 500 }
    },
    "additionalProperties": false
  },
  "MobileMatchLiveLinkHistoryPageResponse": {
    "type": "object",
    "description": "Canonical zero-based history page. The v1 facade aggregates every page to preserve its unbounded raw array until retirement.",
    "required": ["items", "pageInfo"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/MobileMatchLiveLinkHistoryItem"
        }
      },
      "pageInfo": { "$ref": "#/components/schemas/PageInfo" }
    },
    "additionalProperties": false
  },
  "MobileMatchLiveLinkHistoryItem": {
    "type": "object",
    "description": "One live-link version in current createdAt-descending order with no immutable-ID tie-breaker. matchId is route context and is not repeated.",
    "required": [
      "id",
      "provider",
      "url",
      "status",
      "reportCount",
      "ownerAuth0Id",
      "createdAt",
      "lastUpdate"
    ],
    "properties": {
      "id": { "$ref": "#/components/schemas/NumericIdentifier" },
      "provider": { "$ref": "#/components/schemas/LiveProviderEnum" },
      "url": { "type": "string", "maxLength": 1024 },
      "status": { "$ref": "#/components/schemas/LiveLinkStatusEnum" },
      "reportCount": { "type": "integer", "format": "int32", "minimum": 0 },
      "ownerAuth0Id": { "type": "string" },
      "createdAt": { "$ref": "#/components/schemas/UtcDateTime" },
      "lastUpdate": {
        "allOf": [{ "$ref": "#/components/schemas/UtcDateTime" }],
        "nullable": true
      }
    },
    "additionalProperties": false
  }
}
