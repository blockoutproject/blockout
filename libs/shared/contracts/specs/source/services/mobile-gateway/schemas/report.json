{
  "CreateReportRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "title"],
    "properties": {
      "type": { "$ref": "#/components/schemas/ReportTypeEnum" },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "appVersion": { "type": "string" },
      "userId": { "type": "string" },
      "userName": { "type": "string" },
      "screen": { "type": "string" },
      "deviceModel": { "type": "string" },
      "os": { "type": "string" },
      "attachmentImageUrls": { "type": "array", "items": { "type": "string" } }
    }
  },
  "ReportResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "number", "htmlUrl", "title", "state"],
    "properties": {
      "id": { "type": "integer", "format": "int64" },
      "number": { "type": "integer", "format": "int32" },
      "htmlUrl": { "type": "string" },
      "title": { "type": "string" },
      "state": { "type": "string" }
    }
  }
}
