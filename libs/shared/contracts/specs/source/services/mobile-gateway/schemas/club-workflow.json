{
  "MobileClubDetail": {
    "type": "object",
    "description": "Consumer-backed mobile club profile. Phone number, persistence state, audit timestamps, and unused postal code are intentionally absent.",
    "required": [
      "id",
      "rawName",
      "name",
      "address",
      "city",
      "email",
      "website",
      "logoUrl",
      "latitude",
      "longitude"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 255 },
      "rawName": { "type": "string", "maxLength": 255 },
      "name": { "type": "string", "maxLength": 255 },
      "address": { "type": "string", "maxLength": 255, "nullable": true },
      "city": { "type": "string", "maxLength": 255, "nullable": true },
      "email": { "type": "string", "maxLength": 255, "nullable": true },
      "website": { "type": "string", "maxLength": 255, "nullable": true },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "latitude": {
        "type": "number",
        "format": "double",
        "minimum": -90,
        "maximum": 90,
        "nullable": true
      },
      "longitude": {
        "type": "number",
        "format": "double",
        "minimum": -180,
        "maximum": 180,
        "nullable": true
      }
    },
    "additionalProperties": false
  },
  "UpdateMobileClubRequest": {
    "type": "object",
    "description": "Mobile club edit command. Omitted or null name preserves the stored value. removeLogo false keeps or replaces the logo according to image presence; true removes it and forbids an image.",
    "required": ["removeLogo"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "nullable": true
      },
      "removeLogo": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
