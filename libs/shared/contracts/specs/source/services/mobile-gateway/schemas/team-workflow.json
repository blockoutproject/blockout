{
  "MobileTeamDetail": {
    "type": "object",
    "description": "Team profile projection separated from downstream team, club, competition, and pool transports.",
    "required": [
      "id",
      "clubId",
      "name",
      "shortName",
      "rawName",
      "format",
      "gender",
      "season",
      "followersCount",
      "division",
      "logoUrl",
      "pools"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "clubId": { "type": "string", "minLength": 1, "maxLength": 255 },
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "rawName": { "type": "string", "maxLength": 255 },
      "format": { "$ref": "#/components/schemas/FormatEnum" },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "season": { "type": "string", "minLength": 1, "maxLength": 255 },
      "followersCount": { "type": "integer", "format": "int64", "minimum": 0 },
      "division": { "$ref": "#/components/schemas/MobileCatalogDivision" },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "pools": {
        "type": "array",
        "description": "Current competition projection order; no stable pool order is promised in this compatibility slice.",
        "items": { "$ref": "#/components/schemas/MobileTeamPool" }
      }
    },
    "additionalProperties": false
  },
  "MobileTeamPool": {
    "type": "object",
    "description": "Pool ranking tab embedded only in the team workflow, without pool-detail-only or compatibility fields.",
    "required": [
      "id",
      "leagueCode",
      "leagueName",
      "shortName",
      "gender",
      "ranking",
      "division"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "leagueCode": { "type": "string", "maxLength": 255 },
      "leagueName": { "type": "string", "maxLength": 255 },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "ranking": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MobileRankingTeam" }
      },
      "division": { "$ref": "#/components/schemas/MobileCatalogDivision" }
    },
    "additionalProperties": false
  },
  "MobileTeamSummary": {
    "type": "object",
    "description": "Mobile team card projection. A missing division remains explicit for compatibility with current partial enrichment.",
    "required": [
      "id",
      "name",
      "shortName",
      "season",
      "gender",
      "format",
      "logoUrl",
      "division"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "season": { "type": "string", "minLength": 1, "maxLength": 255 },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "format": { "$ref": "#/components/schemas/FormatEnum" },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "division": {
        "allOf": [{ "$ref": "#/components/schemas/MobileCatalogDivision" }],
        "nullable": true
      }
    },
    "additionalProperties": false
  },
  "MobileTeamListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MobileTeamSummary" }
      }
    },
    "additionalProperties": false
  },
  "UpdateMobileTeamRequest": {
    "type": "object",
    "description": "Mobile team edit command. Omitted or null display fields preserve stored values. removeLogo makes keep, replace, and remove intent explicit.",
    "required": ["removeLogo"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "nullable": true
      },
      "shortName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "nullable": true
      },
      "removeLogo": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "MobileTeamUpdated": {
    "type": "object",
    "description": "Narrow result returned to the mobile edit workflow before its explicit refetch.",
    "required": ["id", "name", "shortName", "logoUrl"],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  }
}
