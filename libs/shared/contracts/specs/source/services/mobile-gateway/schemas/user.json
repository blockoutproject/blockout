{
  "UpdateUserRequest": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pseudo": { "type": "string" },
      "pictureUrl": { "type": "string", "nullable": true }
    }
  },
  "UserFavoriteResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["entityType", "entityId"],
    "properties": {
      "entityType": { "$ref": "#/components/schemas/EntityTypeEnum" },
      "entityId": { "type": "integer", "format": "int64" }
    }
  },
  "UserResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "auth0Id",
      "email",
      "pseudo",
      "active",
      "createdAt",
      "lastUpdate"
    ],
    "properties": {
      "id": { "type": "integer", "format": "int64" },
      "auth0Id": { "type": "string" },
      "email": { "type": "string" },
      "pseudo": { "type": "string" },
      "firstName": { "type": "string", "nullable": true },
      "lastName": { "type": "string", "nullable": true },
      "pictureUrl": { "type": "string", "nullable": true },
      "phoneNumber": { "type": "string", "nullable": true },
      "active": { "type": "boolean" },
      "createdAt": { "type": "string", "format": "instant" },
      "lastUpdate": { "type": "string", "format": "instant" },
      "favorites": {
        "type": "array",
        "nullable": true,
        "items": { "$ref": "#/components/schemas/UserFavoriteResponse" }
      }
    }
  }
}
