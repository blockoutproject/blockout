{
  "MobileMatchDayPageResponse": {
    "type": "object",
    "description": "Dedicated page of enriched Paris-local match days. A null or empty downstream body forces hasNext false and nextPage null even when a downstream continuation existed; later enrichment-only drops preserve the downstream continuation.",
    "required": ["dayMatches", "hasNext", "nextPage"],
    "properties": {
      "dayMatches": {
        "type": "array",
        "description": "Day groups in current status-dependent order after empty pools and days are removed.",
        "items": { "$ref": "#/components/schemas/MobileMatchDayGroup" }
      },
      "hasNext": { "type": "boolean" },
      "nextPage": { "type": "integer", "minimum": 0, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileMatchDayGroup": {
    "type": "object",
    "required": ["date", "pools"],
    "properties": {
      "date": { "$ref": "#/components/schemas/CalendarDate" },
      "pools": {
        "type": "array",
        "description": "Pool groups retain downstream pool order after missing or inactive-division groups are silently removed.",
        "minItems": 1,
        "items": { "$ref": "#/components/schemas/MobileMatchPoolGroup" }
      }
    },
    "additionalProperties": false
  },
  "MobileMatchPoolGroup": {
    "type": "object",
    "required": ["pool", "matches"],
    "properties": {
      "pool": { "$ref": "#/components/schemas/MobileMatchListPool" },
      "matches": {
        "type": "array",
        "description": "Match rows retain downstream date order with no immutable-ID tie-breaker.",
        "minItems": 1,
        "items": { "$ref": "#/components/schemas/MobileMatchListItem" }
      }
    },
    "additionalProperties": false
  },
  "MobileMatchListPool": {
    "type": "object",
    "description": "Match-list pool header projection without detail, ranking, follower, lifecycle, or audit fields.",
    "required": [
      "id",
      "leagueCode",
      "leagueName",
      "shortName",
      "gender",
      "division"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "leagueCode": { "type": "string", "maxLength": 255 },
      "leagueName": { "type": "string", "maxLength": 255 },
      "shortName": { "type": "string", "maxLength": 255 },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "division": {
        "$ref": "#/components/schemas/MobileMatchListDivision"
      }
    },
    "additionalProperties": false
  },
  "MobileMatchListDivision": {
    "type": "object",
    "description": "Division label and styling consumed by match-list pool headers and rows.",
    "required": [
      "name",
      "firstGradientColor",
      "secondGradientColor",
      "thirdGradientColor",
      "logoUrl"
    ],
    "properties": {
      "name": { "type": "string", "maxLength": 255 },
      "firstGradientColor": { "type": "string", "maxLength": 255 },
      "secondGradientColor": { "type": "string", "maxLength": 255 },
      "thirdGradientColor": { "type": "string", "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileMatchListItem": {
    "type": "object",
    "description": "Narrow match-list row. Missing team lookups remain nullable partial sides and do not drop the match; the response exposes no partial-result marker.",
    "required": [
      "id",
      "matchDate",
      "set",
      "status",
      "liveUrl",
      "teamA",
      "teamB"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "matchDate": { "$ref": "#/components/schemas/UtcDateTime" },
      "set": { "type": "string", "nullable": true },
      "status": { "$ref": "#/components/schemas/MatchStatusEnum" },
      "liveUrl": {
        "type": "string",
        "maxLength": 1024,
        "nullable": true
      },
      "teamA": {
        "allOf": [{ "$ref": "#/components/schemas/MobileMatchListTeam" }],
        "nullable": true
      },
      "teamB": {
        "allOf": [{ "$ref": "#/components/schemas/MobileMatchListTeam" }],
        "nullable": true
      }
    },
    "additionalProperties": false
  },
  "MobileMatchListTeam": {
    "type": "object",
    "description": "Match-list team label and immutable logo fallback result.",
    "required": ["shortName", "logoUrl"],
    "properties": {
      "shortName": { "type": "string", "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  }
}
