{
  "MobileMatchDetail": {
    "type": "object",
    "description": "Screen-ready match detail separated from list, moderation, downstream owner, persistence, and vendor transports. Every required dependency and both signed continuations are all-or-error.",
    "required": [
      "id",
      "matchDate",
      "set",
      "score",
      "status",
      "venue",
      "firstReferee",
      "secondReferee",
      "liveUrl",
      "liveProvider",
      "liveOwnerAuth0Id",
      "teamA",
      "teamB",
      "pool",
      "signedDocuments"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "matchDate": { "$ref": "#/components/schemas/UtcDateTime" },
      "set": { "type": "string", "nullable": true },
      "score": { "type": "string", "nullable": true },
      "status": { "$ref": "#/components/schemas/MatchStatusEnum" },
      "venue": { "type": "string", "nullable": true },
      "firstReferee": { "type": "string", "nullable": true },
      "secondReferee": { "type": "string", "nullable": true },
      "liveUrl": {
        "type": "string",
        "maxLength": 1024,
        "nullable": true
      },
      "liveProvider": {
        "allOf": [{ "$ref": "#/components/schemas/LiveProviderEnum" }],
        "nullable": true
      },
      "liveOwnerAuth0Id": { "type": "string", "nullable": true },
      "teamA": { "$ref": "#/components/schemas/MobileMatchDetailTeam" },
      "teamB": { "$ref": "#/components/schemas/MobileMatchDetailTeam" },
      "pool": { "$ref": "#/components/schemas/MobileMatchDetailPool" },
      "signedDocuments": {
        "$ref": "#/components/schemas/MobileMatchSignedDocuments"
      }
    },
    "additionalProperties": false
  },
  "MobileMatchDetailTeam": {
    "type": "object",
    "description": "Match-detail team identity and display projection.",
    "required": ["id", "name", "shortName", "logoUrl"],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "name": { "type": "string", "maxLength": 255 },
      "shortName": { "type": "string", "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileMatchDetailPool": {
    "type": "object",
    "description": "Match-detail pool metadata, styling, and ranking projection without pool-profile-only fields.",
    "required": [
      "id",
      "season",
      "poolCode",
      "leagueCode",
      "leagueName",
      "name",
      "shortName",
      "gender",
      "ranking",
      "division"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "season": { "type": "string", "maxLength": 255 },
      "poolCode": { "type": "string", "maxLength": 255 },
      "leagueCode": { "type": "string", "maxLength": 255 },
      "leagueName": { "type": "string", "maxLength": 255 },
      "name": { "type": "string", "maxLength": 255 },
      "shortName": { "type": "string", "maxLength": 255 },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "ranking": {
        "type": "array",
        "description": "Current five-key gateway ranking order. Exact ties retain unspecified association order; array position is authoritative and no ordinal is invented.",
        "items": { "$ref": "#/components/schemas/MobileMatchRankingTeam" }
      },
      "division": {
        "$ref": "#/components/schemas/MobileMatchDetailDivision"
      }
    },
    "additionalProperties": false
  },
  "MobileMatchDetailDivision": {
    "type": "object",
    "description": "Division label, highlight, gradient, and logo inputs consumed by the match screen.",
    "required": [
      "name",
      "mainColor",
      "firstGradientColor",
      "secondGradientColor",
      "thirdGradientColor",
      "logoUrl"
    ],
    "properties": {
      "name": { "type": "string", "maxLength": 255 },
      "mainColor": { "type": "string", "maxLength": 255 },
      "firstGradientColor": { "type": "string", "maxLength": 255 },
      "secondGradientColor": { "type": "string", "maxLength": 255 },
      "thirdGradientColor": { "type": "string", "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileMatchRankingTeam": {
    "type": "object",
    "description": "Match-screen ranking row. Comparator inputs not rendered by Expo remain internal to the projector.",
    "required": [
      "id",
      "shortName",
      "logoUrl",
      "points",
      "played",
      "wins",
      "losses"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "shortName": { "type": "string", "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "points": { "type": "integer", "format": "int32" },
      "played": { "type": "integer", "format": "int32" },
      "wins": { "type": "integer", "format": "int32" },
      "losses": { "type": "integer", "format": "int32" }
    },
    "additionalProperties": false
  },
  "MobileMatchSignedDocuments": {
    "type": "object",
    "description": "BFF-owned short-lived continuations to federation PDFs. Both URLs are produced when detail succeeds; missing claims or signing failure abort the detail under the current policy.",
    "required": ["addressPdfUrl", "sheetPdfUrl"],
    "properties": {
      "addressPdfUrl": { "type": "string", "format": "uri" },
      "sheetPdfUrl": { "type": "string", "format": "uri" }
    },
    "additionalProperties": false
  }
}
