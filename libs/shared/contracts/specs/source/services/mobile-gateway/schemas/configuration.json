{
  "MobileAppStatus": {
    "type": "object",
    "description": "Expo-facing application status without persistence identity.",
    "required": [
      "maintenance",
      "message",
      "imageUrl",
      "minVersionIos",
      "minVersionAndroid",
      "storeUrlIos",
      "storeUrlAndroid",
      "forceUpdateMessage",
      "lastUpdate"
    ],
    "properties": {
      "maintenance": { "type": "boolean" },
      "message": { "type": "string", "nullable": true },
      "imageUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "minVersionIos": { "type": "string", "maxLength": 255, "nullable": true },
      "minVersionAndroid": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "storeUrlIos": { "type": "string", "maxLength": 2048, "nullable": true },
      "storeUrlAndroid": {
        "type": "string",
        "maxLength": 2048,
        "nullable": true
      },
      "forceUpdateMessage": { "type": "string", "nullable": true },
      "lastUpdate": { "$ref": "#/components/schemas/UtcDateTime" }
    },
    "additionalProperties": false
  },
  "UpdateMobileAppStatusRequest": {
    "type": "object",
    "description": "Partial mobile administration command. Omitted and null properties both preserve the stored value.",
    "properties": {
      "maintenance": { "type": "boolean", "nullable": true },
      "message": { "type": "string", "nullable": true },
      "imageUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "minVersionIos": { "type": "string", "maxLength": 255, "nullable": true },
      "minVersionAndroid": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "storeUrlIos": { "type": "string", "maxLength": 2048, "nullable": true },
      "storeUrlAndroid": {
        "type": "string",
        "maxLength": 2048,
        "nullable": true
      },
      "forceUpdateMessage": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileDivision": {
    "type": "object",
    "description": "Expo-facing division catalog item.",
    "required": [
      "id",
      "name",
      "mainColor",
      "firstGradientColor",
      "secondGradientColor",
      "thirdGradientColor",
      "logoUrl",
      "active"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "mainColor": { "type": "string", "minLength": 1, "maxLength": 32 },
      "firstGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "secondGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "thirdGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "active": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "MobileDivisionListResponse": {
    "type": "object",
    "description": "Bounded active division catalog in current downstream order.",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MobileDivision" }
      }
    },
    "additionalProperties": false
  },
  "CreateMobileDivisionRequest": {
    "type": "object",
    "required": [
      "name",
      "mainColor",
      "firstGradientColor",
      "secondGradientColor",
      "thirdGradientColor"
    ],
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "mainColor": { "type": "string", "minLength": 1, "maxLength": 32 },
      "firstGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "secondGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "thirdGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "additionalProperties": false
  },
  "UpdateMobileDivisionRequest": {
    "type": "object",
    "description": "Partial division update. Omitted and null values preserve downstream state.",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "nullable": true
      },
      "mainColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "nullable": true
      },
      "firstGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "nullable": true
      },
      "secondGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "nullable": true
      },
      "thirdGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "nullable": true
      }
    },
    "additionalProperties": false
  },
  "MobileLegalDocument": {
    "type": "object",
    "required": ["type", "title", "version", "content"],
    "properties": {
      "type": { "type": "string", "minLength": 1, "maxLength": 50 },
      "title": { "type": "string", "nullable": true },
      "version": { "type": "string", "nullable": true },
      "content": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  },
  "UpdateMobileLegalDocumentRequest": {
    "type": "object",
    "description": "Partial legal-document update. Omitted and null values preserve stored content.",
    "properties": {
      "title": { "type": "string", "nullable": true },
      "version": { "type": "string", "nullable": true },
      "content": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileRawDivisionMapping": {
    "type": "object",
    "required": [
      "id",
      "rawDivisionName",
      "divisionId",
      "format",
      "gender",
      "leagueCode",
      "season"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "rawDivisionName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "nullable": true
      },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      },
      "leagueCode": { "type": "string", "minLength": 1, "maxLength": 255 },
      "season": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "additionalProperties": false
  },
  "MobileRawDivisionMappingListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MobileRawDivisionMapping" }
      }
    },
    "additionalProperties": false
  },
  "CreateMobileRawDivisionMappingRequest": {
    "type": "object",
    "required": ["rawDivisionName", "leagueCode", "season"],
    "properties": {
      "rawDivisionName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "nullable": true
      },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      },
      "leagueCode": { "type": "string", "minLength": 1, "maxLength": 255 },
      "season": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "additionalProperties": false
  },
  "UpdateMobileRawDivisionMappingRequest": {
    "type": "object",
    "required": ["divisionId", "format", "gender"],
    "properties": {
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "nullable": true
      },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      }
    },
    "additionalProperties": false
  },
  "MobileScraperStatus": {
    "type": "object",
    "required": ["name", "enabled"],
    "properties": {
      "name": { "$ref": "#/components/schemas/ScraperNameEnum" },
      "enabled": { "type": "boolean" }
    },
    "additionalProperties": false
  },
  "MobileScraperStatusListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MobileScraperStatus" }
      }
    },
    "additionalProperties": false
  }
}
