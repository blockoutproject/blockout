{
  "MobileClubSearchResult": {
    "type": "object",
    "description": "Club card and navigation projection consumed by Expo search.",
    "required": ["id", "name", "logoUrl", "city"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 255 },
      "name": { "type": "string", "nullable": true },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "city": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileClubSearchListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": { "$ref": "#/components/schemas/MobileClubSearchResult" }
      }
    },
    "additionalProperties": false
  },
  "MobileTeamSearchResult": {
    "type": "object",
    "description": "Team card, label, image, and navigation projection consumed by Expo search.",
    "required": [
      "id",
      "name",
      "logoUrl",
      "divisionName",
      "format",
      "gender",
      "season"
    ],
    "properties": {
      "id": { "$ref": "#/components/schemas/NumericIdentifier" },
      "name": { "type": "string", "nullable": true },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "divisionName": { "type": "string", "nullable": true },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      },
      "season": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileTeamSearchListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": { "$ref": "#/components/schemas/MobileTeamSearchResult" }
      }
    },
    "additionalProperties": false
  },
  "MobilePoolSearchResult": {
    "type": "object",
    "description": "Pool card, label, image, and navigation projection consumed by Expo search.",
    "required": [
      "id",
      "name",
      "divisionName",
      "leagueCode",
      "leagueName",
      "season",
      "format",
      "gender",
      "logoUrl"
    ],
    "properties": {
      "id": { "$ref": "#/components/schemas/NumericIdentifier" },
      "name": { "type": "string", "nullable": true },
      "divisionName": { "type": "string", "nullable": true },
      "leagueCode": { "type": "string", "nullable": true },
      "leagueName": { "type": "string", "nullable": true },
      "season": { "type": "string", "nullable": true },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobilePoolSearchListResponse": {
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 20,
        "items": { "$ref": "#/components/schemas/MobilePoolSearchResult" }
      }
    },
    "additionalProperties": false
  }
}
