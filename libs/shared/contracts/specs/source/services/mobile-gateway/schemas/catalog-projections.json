{
  "MobileCatalogDivision": {
    "type": "object",
    "description": "Division styling and label fields consumed inside mobile team, pool, card, ranking, and map workflows.",
    "required": [
      "name",
      "mainColor",
      "firstGradientColor",
      "secondGradientColor",
      "thirdGradientColor",
      "logoUrl"
    ],
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "mainColor": { "type": "string", "minLength": 1, "maxLength": 32 },
      "firstGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "secondGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "thirdGradientColor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true }
    },
    "additionalProperties": false
  },
  "MobileRankingTeam": {
    "type": "object",
    "description": "Mobile ranking and map row. Position in the containing array is authoritative. The current five-key ranking sort is preserved; exact ties retain unspecified source order because no identifier tie-breaker is introduced in this compatibility slice.",
    "required": [
      "id",
      "shortName",
      "logoUrl",
      "points",
      "played",
      "wins",
      "losses",
      "latitude",
      "longitude"
    ],
    "properties": {
      "id": { "$ref": "#/components/schemas/NumericIdentifier" },
      "shortName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "points": { "type": "integer", "format": "int32" },
      "played": { "type": "integer", "format": "int32" },
      "wins": { "type": "integer", "format": "int32" },
      "losses": { "type": "integer", "format": "int32" },
      "latitude": {
        "type": "number",
        "format": "double",
        "minimum": -90,
        "maximum": 90,
        "nullable": true
      },
      "longitude": {
        "type": "number",
        "format": "double",
        "minimum": -180,
        "maximum": 180,
        "nullable": true
      }
    },
    "additionalProperties": false
  }
}
