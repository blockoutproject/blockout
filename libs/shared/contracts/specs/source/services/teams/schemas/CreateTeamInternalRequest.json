{
  "CreateTeamInternalRequest": {
    "type": "object",
    "description": "Team creation input containing only caller-owned identity and classification fields. Server identity, follower projection, lifecycle, logo storage, and audit timestamps are not client-controlled.",
    "required": [
      "clubId",
      "rawName",
      "name",
      "shortName",
      "leagueCode",
      "divisionId",
      "season",
      "format",
      "gender"
    ],
    "properties": {
      "clubId": {
        "type": "string",
        "maxLength": 255
      },
      "rawName": {
        "type": "string",
        "maxLength": 255
      },
      "name": {
        "type": "string",
        "maxLength": 255
      },
      "shortName": {
        "type": "string",
        "maxLength": 255
      },
      "leagueCode": {
        "type": "string",
        "maxLength": 255
      },
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "season": {
        "type": "string",
        "maxLength": 255
      },
      "format": {
        "$ref": "#/components/schemas/FormatEnum"
      },
      "gender": {
        "$ref": "#/components/schemas/GenderEnum"
      }
    },
    "additionalProperties": false
  }
}
