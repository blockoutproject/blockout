{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Search Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [{ "name": "Search" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "parameters": {
      "SearchQuery": {
        "name": "query",
        "in": "query",
        "required": true,
        "description": "Search text. An empty or whitespace-only value intentionally selects random examples instead of being rejected.",
        "schema": { "type": "string" }
      },
      "SearchSeason": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": { "type": "string" }
      },
      "SearchDivisionId": {
        "name": "divisionId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "SearchFormat": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/FormatEnum" }
      },
      "SearchGender": {
        "name": "gender",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/GenderEnum" }
      }
    }
  }
}
