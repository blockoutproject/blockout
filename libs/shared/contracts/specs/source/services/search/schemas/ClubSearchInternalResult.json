{
  "ClubSearchInternalResult": {
    "type": "object",
    "description": "Club autocomplete result separated from the Elasticsearch document and its derived index-only fields.",
    "required": ["id", "name", "logoUrl", "city"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 255 },
      "name": { "type": "string", "nullable": true },
      "logoUrl": { "type": "string", "maxLength": 2048, "nullable": true },
      "city": { "type": "string", "nullable": true }
    },
    "additionalProperties": false
  }
}
