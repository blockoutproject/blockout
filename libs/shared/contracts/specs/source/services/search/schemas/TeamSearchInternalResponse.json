{
  "TeamSearchInternalResponse": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "clubId", "season", "format", "gender"],
    "properties": {
      "id": { "type": "integer", "format": "int64" },
      "name": { "type": "string" },
      "shortName": { "type": "string", "nullable": true },
      "clubId": { "type": "string" },
      "clubName": { "type": "string", "nullable": true },
      "clubCity": { "type": "string", "nullable": true },
      "logoUrl": { "type": "string", "nullable": true },
      "divisionName": { "type": "string", "nullable": true },
      "format": { "$ref": "#/components/schemas/FormatEnum" },
      "gender": { "$ref": "#/components/schemas/GenderEnum" },
      "season": { "type": "string" }
    }
  }
}
