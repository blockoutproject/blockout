{
  "UserAccountInternalResponse": {
    "type": "object",
    "description": "Required account/profile view for current consumers. The local UUID is canonical; Auth0 subject remains only for the audited identity and live-owner compatibility workflows. Names, phone, active state, and persistence update timestamp remain v1-only compatibility fields.",
    "required": [
      "id",
      "auth0Id",
      "email",
      "pseudo",
      "pictureUrl",
      "createdAt",
      "favorites"
    ],
    "properties": {
      "id": { "$ref": "#/components/schemas/UuidIdentifier" },
      "auth0Id": { "type": "string", "minLength": 1, "maxLength": 255 },
      "email": { "type": "string", "format": "email", "maxLength": 255 },
      "pseudo": { "type": "string", "minLength": 1, "maxLength": 255 },
      "pictureUrl": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048,
        "nullable": true
      },
      "createdAt": { "$ref": "#/components/schemas/UtcDateTime" },
      "favorites": {
        "type": "array",
        "nullable": true,
        "items": { "$ref": "#/components/schemas/UserFavoriteSummary" }
      }
    },
    "additionalProperties": false
  }
}
