{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Users Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    { "name": "UserAccounts" },
    { "name": "UserIdentity" },
    { "name": "UserFavorites" }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "internalApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "Exact internal role-assignment key. This scheme is isolated from bearer-authenticated user operations."
      }
    },
    "parameters": {
      "Auth0Id": {
        "name": "auth0Id",
        "in": "path",
        "required": true,
        "description": "Auth0 subject accepted only by identity-facing compatibility operations.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 255 }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "Canonical positive numeric local Blockout user identifier.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "FavoriteEntityType": {
        "name": "entityType",
        "in": "query",
        "required": false,
        "schema": { "$ref": "#/components/schemas/EntityTypeEnum" }
      },
      "RequiredFavoriteEntityType": {
        "name": "entityType",
        "in": "query",
        "required": true,
        "schema": { "$ref": "#/components/schemas/EntityTypeEnum" }
      },
      "FavoriteEntityId": {
        "name": "entityId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    }
  }
}
