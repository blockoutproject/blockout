{
  "CreateClubInternalRequest": {
    "type": "object",
    "description": "Club creation data carried by the canonical multipart JSON part. An optional image part creates the logo. Address is intentionally absent because the current create path drops it; adding it requires a separately approved behavior correction.",
    "required": ["id", "rawName", "name"],
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 255
      },
      "rawName": {
        "type": "string",
        "maxLength": 255
      },
      "name": {
        "type": "string",
        "maxLength": 255
      },
      "city": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "postalCode": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "email": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "phoneNumber": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "website": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      }
    },
    "additionalProperties": false
  }
}
