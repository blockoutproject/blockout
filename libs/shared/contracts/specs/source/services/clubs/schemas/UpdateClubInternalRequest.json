{
  "UpdateClubInternalRequest": {
    "type": "object",
    "description": "Partial club update carried by the canonical multipart JSON part. Omitted and explicit-null ordinary fields preserve stored values. removeLogo is always explicit: false without an image keeps the logo, false with an image replaces it, and true without an image deletes it. removeLogo true with an image is invalid. Every successful update reactivates the club.",
    "required": ["removeLogo"],
    "properties": {
      "rawName": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "name": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "address": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "city": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "postalCode": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "email": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "phoneNumber": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "website": {
        "type": "string",
        "maxLength": 255,
        "nullable": true
      },
      "removeLogo": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  }
}
