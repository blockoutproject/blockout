{
  "/api/v1/notifications": {
    "get": {
      "tags": ["Notification"],
      "operationId": "listNotifications",
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "schema": { "type": "integer", "default": 0 }
        },
        {
          "name": "size",
          "in": "query",
          "schema": { "type": "integer", "default": 20 }
        }
      ],
      "responses": {
        "200": {
          "description": "Notification page",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPageInternalResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/notifications/unread-count": {
    "get": {
      "tags": ["Notification"],
      "operationId": "getUnreadCount",
      "responses": {
        "200": {
          "description": "Unread notification count",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnreadCountInternalResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/notifications/{id}/read": {
    "post": {
      "tags": ["Notification"],
      "operationId": "markNotificationRead",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": {
        "204": { "description": "Marked as read" },
        "404": { "description": "Notification not found" }
      }
    }
  },
  "/api/v1/notifications/{id}/opened": {
    "post": {
      "tags": ["Notification"],
      "operationId": "markNotificationOpened",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": {
        "204": { "description": "Marked as opened" },
        "404": { "description": "Notification not found" }
      }
    }
  },
  "/api/v1/notifications/{id}": {
    "delete": {
      "tags": ["Notification"],
      "operationId": "deleteNotification",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "responses": {
        "204": { "description": "Deleted" },
        "404": { "description": "Notification not found" }
      }
    }
  },
  "/api/v1/notifications/users/{userId}/push-tokens": {
    "post": {
      "tags": ["PushToken"],
      "operationId": "registerPushToken",
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": { "type": "integer", "format": "int64" }
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RegisterPushTokenInternalRequest"
            }
          }
        }
      },
      "responses": {
        "202": { "description": "Push token registered" },
        "404": { "description": "User not found" }
      }
    }
  }
}
