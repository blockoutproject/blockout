{
  "/api/v2/pools": {
    "get": {
      "operationId": "listPools",
      "tags": ["Pools"],
      "summary": "List pools",
      "description": "Returns a page of pools ordered by season descending, name ascending with null names last, and identifier ascending. Empty or omitted ids preserve the all-pools filter; compatibility callers that require the legacy complete list aggregate every page.",
      "parameters": [
        { "$ref": "#/components/parameters/PoolLeagueCode" },
        { "$ref": "#/components/parameters/PoolSeason" },
        { "$ref": "#/components/parameters/PoolActive" },
        { "$ref": "#/components/parameters/PoolIds" },
        { "$ref": "#/components/parameters/Page" },
        { "$ref": "#/components/parameters/PageSize" }
      ],
      "responses": {
        "200": {
          "description": "Requested pool page.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoolInternalPageResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    },
    "post": {
      "operationId": "createPool",
      "tags": ["Pools"],
      "summary": "Create a pool",
      "description": "Creates a pool with server-owned identity, follower count, active state, and audit timestamps.",
      "x-required-scope": "create:pools",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreatePoolInternalRequest"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Pool created.",
          "headers": {
            "Location": {
              "description": "Canonical location of the created pool.",
              "schema": { "type": "string" }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoolInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    }
  },
  "/api/v2/pools/{id}": {
    "parameters": [{ "$ref": "#/components/parameters/PoolId" }],
    "get": {
      "operationId": "getPool",
      "tags": ["Pools"],
      "summary": "Get a pool",
      "description": "Returns one active or inactive pool by its numeric identifier.",
      "responses": {
        "200": {
          "description": "Requested pool.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoolInternalResponse"
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    },
    "put": {
      "operationId": "updatePool",
      "tags": ["Pools"],
      "summary": "Update a pool",
      "description": "Partially updates pool identity, display, classification, or explicit lifecycle state. Omitted and explicit-null fields preserve their current values; active true is explicit reactivation and active false is explicit deactivation.",
      "x-required-scope": "update:pools",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdatePoolInternalRequest"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Updated pool.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoolInternalResponse"
              }
            }
          }
        },
        "400": { "$ref": "#/components/responses/BadRequestProblem" },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "409": { "$ref": "#/components/responses/ConflictProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    },
    "delete": {
      "operationId": "deactivatePool",
      "tags": ["Pools"],
      "summary": "Deactivate a pool",
      "description": "Soft-deactivates the pool without changing the current direct-delete event behavior.",
      "x-required-scope": "delete:pools",
      "responses": {
        "204": { "description": "Pool deactivated." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    }
  },
  "/api/v2/pools/{poolId}/followers/increment": {
    "parameters": [
      { "$ref": "#/components/parameters/FollowerPoolId" },
      { "$ref": "#/components/parameters/FollowerUserId" }
    ],
    "post": {
      "operationId": "incrementPoolFollowers",
      "tags": ["PoolFollowers"],
      "summary": "Increment the pool follower projection",
      "description": "Increments the derived follower count for the canonical favorite owner. The legacy v1 adapter retains its unused full-pool response.",
      "x-required-scope": "follow:pools",
      "responses": {
        "204": { "description": "Follower projection incremented." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    }
  },
  "/api/v2/pools/{poolId}/followers/decrement": {
    "parameters": [
      { "$ref": "#/components/parameters/FollowerPoolId" },
      { "$ref": "#/components/parameters/FollowerUserId" }
    ],
    "post": {
      "operationId": "decrementPoolFollowers",
      "tags": ["PoolFollowers"],
      "summary": "Decrement the pool follower projection",
      "description": "Decrements the derived follower count with the current zero floor. The legacy v1 adapter retains its unused full-pool response.",
      "x-required-scope": "follow:pools",
      "responses": {
        "204": { "description": "Follower projection decremented." },
        "401": { "$ref": "#/components/responses/UnauthorizedProblem" },
        "403": { "$ref": "#/components/responses/ForbiddenProblem" },
        "404": { "$ref": "#/components/responses/NotFoundProblem" },
        "500": {
          "$ref": "#/components/responses/InternalServerErrorProblem"
        }
      }
    }
  }
}
