{
  "UpdatePoolInternalRequest": {
    "type": "object",
    "description": "Partial pool update. Omitted and explicit-null fields preserve stored values. Active true explicitly requests reactivation; active false explicitly requests deactivation. Application mapping separates lifecycle intent from identity, display, and classification changes.",
    "properties": {
      "poolCode": { "type": "string", "maxLength": 255, "nullable": true },
      "leagueCode": { "type": "string", "maxLength": 255, "nullable": true },
      "season": { "type": "string", "maxLength": 255, "nullable": true },
      "leagueName": { "type": "string", "maxLength": 255, "nullable": true },
      "rawName": { "type": "string", "maxLength": 255, "nullable": true },
      "name": { "type": "string", "maxLength": 255, "nullable": true },
      "shortName": { "type": "string", "maxLength": 255, "nullable": true },
      "divisionId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "nullable": true
      },
      "format": {
        "allOf": [{ "$ref": "#/components/schemas/FormatEnum" }],
        "nullable": true
      },
      "gender": {
        "allOf": [{ "$ref": "#/components/schemas/GenderEnum" }],
        "nullable": true
      },
      "active": { "type": "boolean", "nullable": true }
    },
    "additionalProperties": false
  }
}
