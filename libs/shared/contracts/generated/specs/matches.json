        }
      },
      "MatchActive": {
        "name": "active",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      "DayPageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 4
        }
      },
      "LiveLinkStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/LiveLinkStatusEnum"
        }
      }
