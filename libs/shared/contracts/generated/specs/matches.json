      ],
      "put": {
        "operationId": "bulkDeactivateMatchesByPool",
        "tags": [
          "Matches"
        ],
        "summary": "Deactivate missing matches in a pool",
        "description": "Soft-deactivates supplied missingMatchCodes. Empty is a no-op; duplicates retain set semantics. The v1 adapter keeps its empty 200 response.",
