{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Competition Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "CompetitionAssociations"
    },
    {
      "name": "CompetitionStatistics"
    },
    {
      "name": "CompetitionLifecycle"
    },
    {
      "name": "CompetitionRankings"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/competitions/pools/{poolId}/teams/{teamId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PoolId"
        },
        {
          "$ref": "#/components/parameters/TeamId"
        }
      ],
      "post": {
        "operationId": "addOrReactivateCompetitionAssociation",
        "tags": [
          "CompetitionAssociations"
        ],
        "summary": "Add or reactivate a team in a pool",
        "description": "Creates a zero-stat association or reactivates the existing association while preserving its statistics and stored club identity. The caller must hold both listed scopes.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AssociationClubId"
          }
        ],
        "responses": {
          "200": {
            "description": "Created, existing, or reactivated association.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionAssociationInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/pools/{poolId}/teams": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PoolId"
        }
      ],
      "get": {
        "operationId": "listCompetitionAssociationsByPool",
        "tags": [
          "CompetitionAssociations"
        ],
        "summary": "List active associations for a pool",
        "description": "Returns active associations ordered by teamId ascending. Compatibility callers aggregate all pages and retain the legacy empty-array behavior.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested association page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionAssociationInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/teams/{teamId}/pools": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TeamId"
        }
      ],
      "get": {
        "operationId": "listCompetitionAssociationsByTeam",
        "tags": [
          "CompetitionAssociations"
        ],
        "summary": "List active associations for a team",
        "description": "Returns active associations ordered by poolId ascending. Compatibility callers aggregate all pages and retain the legacy empty-array behavior.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested association page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionAssociationInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/pools/{poolId}/teams/bulk-deactivate": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PoolId"
        }
      ],
      "put": {
        "operationId": "bulkDeactivateCompetitionTeamsByPool",
        "tags": [
          "CompetitionLifecycle"
        ],
        "summary": "Deactivate missing teams in a pool",
        "description": "Deactivates active associations for the supplied missingTeamIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissingTeamIdsInternalRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Lifecycle command completed."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/pools/bulk-deactivate": {
      "put": {
        "operationId": "bulkDeactivateCompetitionPools",
        "tags": [
          "CompetitionLifecycle"
        ],
        "summary": "Deactivate missing pools",
        "description": "Deactivates active associations for the supplied missingPoolIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissingPoolIdsInternalRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Lifecycle command completed."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/clubs/bulk-deactivate": {
      "put": {
        "operationId": "bulkDeactivateCompetitionClubs",
        "tags": [
          "CompetitionLifecycle"
        ],
        "summary": "Deactivate missing clubs",
        "description": "Deactivates active associations for the supplied missingClubIds. Duplicate identifiers have set semantics; an empty list is a no-op. The v1 adapter retains its empty 200 response.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MissingClubIdsInternalRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Lifecycle command completed."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/pools/{poolId}/teams/{teamId}/stats": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PoolId"
        },
        {
          "$ref": "#/components/parameters/TeamId"
        }
      ],
      "put": {
        "operationId": "replaceCompetitionStatistics",
        "tags": [
          "CompetitionStatistics"
        ],
        "summary": "Replace association statistics",
        "description": "Atomically replaces all seventeen statistics for the identified association. Partial snapshots and null statistics are invalid.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionStatisticsSnapshotInternalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated association snapshot.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionAssociationInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/competitions/teams/{teamId}/pools-with-ranking": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TeamId"
        }
      ],
      "get": {
        "operationId": "listPoolRankingsByTeam",
        "tags": [
          "CompetitionRankings"
        ],
        "summary": "List pool rankings for a team",
        "description": "Returns pool groups ordered by poolId ascending. Each complete ranking is ordered by points descending, pointsPenalty ascending, wins descending, coefSets descending, coefPoints descending, then teamId ascending as a deterministic technical tie-breaker. Empty results return an empty page.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested pool-ranking page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolRankingInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "PoolId": {
        "name": "poolId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "TeamId": {
        "name": "teamId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "AssociationClubId": {
        "name": "clubId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "CompetitionAssociationInternalResponse": {
        "type": "object",
        "description": "Competition-owned association and full statistics snapshot without persistence identity or audit timestamps.",
        "required": [
          "poolId",
          "teamId",
          "clubId",
          "active",
          "points",
          "played",
          "wins",
          "losses",
          "winsThreeToZero",
          "winsThreeToOne",
          "winsThreeToTwo",
          "lossesZeroToThree",
          "lossesOneToThree",
          "lossesTwoToThree",
          "wonSets",
          "lostSets",
          "wonPoints",
          "lostPoints",
          "pointsPenalty",
          "coefSets",
          "coefPoints"
        ],
        "properties": {
          "poolId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "teamId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "clubId": {
            "type": "string",
            "maxLength": 255
          },
          "active": {
            "type": "boolean"
          },
          "points": {
            "type": "integer",
            "format": "int32"
          },
          "played": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToZero": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToOne": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToTwo": {
            "type": "integer",
            "format": "int32"
          },
          "lossesZeroToThree": {
            "type": "integer",
            "format": "int32"
          },
          "lossesOneToThree": {
            "type": "integer",
            "format": "int32"
          },
          "lossesTwoToThree": {
            "type": "integer",
            "format": "int32"
          },
          "wonSets": {
            "type": "integer",
            "format": "int32"
          },
          "lostSets": {
            "type": "integer",
            "format": "int32"
          },
          "wonPoints": {
            "type": "integer",
            "format": "int32"
          },
          "lostPoints": {
            "type": "integer",
            "format": "int32"
          },
          "pointsPenalty": {
            "type": "integer",
            "format": "int32"
          },
          "coefSets": {
            "type": "number",
            "format": "double"
          },
          "coefPoints": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CompetitionAssociationInternalPageResponse": {
        "type": "object",
        "description": "One stable page of active competition associations. Pool reads order by team identifier; team reads order by pool identifier.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionAssociationInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "MissingTeamIdsInternalRequest": {
        "type": "object",
        "description": "Team identifiers proven missing from one pool and therefore selected for association deactivation. An empty list is a valid no-op.",
        "required": [
          "missingTeamIds"
        ],
        "properties": {
          "missingTeamIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        },
        "additionalProperties": false
      },
      "MissingPoolIdsInternalRequest": {
        "type": "object",
        "description": "Pool identifiers proven missing from the source and therefore selected for association deactivation. An empty list is a valid no-op.",
        "required": [
          "missingPoolIds"
        ],
        "properties": {
          "missingPoolIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        },
        "additionalProperties": false
      },
      "MissingClubIdsInternalRequest": {
        "type": "object",
        "description": "Club identifiers proven missing from the source and therefore selected for association deactivation. An empty list is a valid no-op.",
        "required": [
          "missingClubIds"
        ],
        "properties": {
          "missingClubIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            }
          }
        },
        "additionalProperties": false
      },
      "CompetitionStatisticsSnapshotInternalRequest": {
        "type": "object",
        "description": "Required full replacement of all seventeen stored statistics. Values retain the audited scraper semantics; this contract does not invent official league validation or change coefficient sentinels.",
        "required": [
          "played",
          "wins",
          "losses",
          "points",
          "winsThreeToZero",
          "winsThreeToOne",
          "winsThreeToTwo",
          "lossesZeroToThree",
          "lossesOneToThree",
          "lossesTwoToThree",
          "wonSets",
          "lostSets",
          "wonPoints",
          "lostPoints",
          "pointsPenalty",
          "coefSets",
          "coefPoints"
        ],
        "properties": {
          "played": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "points": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToZero": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToOne": {
            "type": "integer",
            "format": "int32"
          },
          "winsThreeToTwo": {
            "type": "integer",
            "format": "int32"
          },
          "lossesZeroToThree": {
            "type": "integer",
            "format": "int32"
          },
          "lossesOneToThree": {
            "type": "integer",
            "format": "int32"
          },
          "lossesTwoToThree": {
            "type": "integer",
            "format": "int32"
          },
          "wonSets": {
            "type": "integer",
            "format": "int32"
          },
          "lostSets": {
            "type": "integer",
            "format": "int32"
          },
          "wonPoints": {
            "type": "integer",
            "format": "int32"
          },
          "lostPoints": {
            "type": "integer",
            "format": "int32"
          },
          "pointsPenalty": {
            "type": "integer",
            "format": "int32"
          },
          "coefSets": {
            "type": "number",
            "format": "double"
          },
          "coefPoints": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "PoolRankingInternalPageResponse": {
        "type": "object",
        "description": "One page of pool ranking groups ordered by pool identifier ascending. Each nested ranking is complete and applies the competition-owned policy.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PoolRankingInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PoolRankingInternalResponse": {
        "type": "object",
        "description": "One pool and its complete active-team ranking ordered by points descending, pointsPenalty ascending, wins descending, coefSets descending, coefPoints descending, then teamId ascending as the deterministic technical tie-breaker.",
        "required": [
          "poolId",
          "ranking"
        ],
        "properties": {
          "poolId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "ranking": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamRankingInternalResponse"
            }
          }
        },
        "additionalProperties": false
      },
