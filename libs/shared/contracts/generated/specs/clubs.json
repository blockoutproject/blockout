{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Clubs Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "Clubs"
    },
    {
      "name": "ClubLogos"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/clubs": {
      "get": {
        "operationId": "listClubs",
        "tags": [
          "Clubs"
        ],
        "summary": "List clubs",
        "description": "Returns a page of clubs ordered by name and then identifier. Empty or omitted ids preserve the all-clubs filter; compatibility callers that require the legacy complete list aggregate every page.",
        "x-required-scope": "read:clubs",
        "parameters": [
          {
            "$ref": "#/components/parameters/ClubIds"
          },
          {
            "$ref": "#/components/parameters/ClubActive"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested club page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "post": {
        "operationId": "createClub",
        "tags": [
          "Clubs"
        ],
        "summary": "Create a club",
        "description": "Creates a club from a canonical camelCase JSON part and an optional PNG or JPEG image. The current five-megabyte image and request limits remain adapter-owned compatibility behavior.",
        "x-required-scope": "create:clubs",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/CreateClubInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Club created.",
            "headers": {
              "Location": {
                "description": "Canonical location of the created club.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/clubs/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ClubId"
        }
      ],
      "get": {
        "operationId": "getClub",
        "tags": [
          "Clubs"
        ],
        "summary": "Get a club",
        "description": "Returns one active or inactive club by its owner identifier.",
        "x-required-scope": "read:clubs",
        "responses": {
          "200": {
            "description": "Requested club.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateClub",
        "tags": [
          "Clubs"
        ],
        "summary": "Update a club",
        "description": "Partially updates a club from a canonical camelCase JSON part, applies its explicit logo intent, and preserves the current implicit reactivation behavior.",
        "x-required-scope": "update:clubs",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/UpdateClubInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated and active club.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "deactivateClub",
        "tags": [
          "Clubs"
        ],
        "summary": "Deactivate a club",
        "description": "Soft-deactivates the club without changing the current direct-delete event behavior.",
        "x-required-scope": "delete:clubs",
        "responses": {
          "204": {
            "description": "Club deactivated."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/clubs/{id}/logo": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ClubId"
        }
      ],
      "get": {
        "operationId": "getClubLogo",
        "tags": [
          "ClubLogos"
        ],
        "summary": "Get a club logo URL",
        "description": "Returns the current plain-text logo URL, or no content when the club has no logo. Authentication remains required without a method-level scope.",
        "responses": {
          "200": {
            "description": "Current club logo URL.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "204": {
            "description": "The club has no logo."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "ClubId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "ClubIds": {
        "name": "ids",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "ClubActive": {
        "name": "active",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "ClubInternalPageResponse": {
        "type": "object",
        "description": "One page of clubs ordered by name ascending and then identifier ascending. Consumers that require the legacy complete list aggregate pages in this order.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClubInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "CreateClubInternalRequest": {
        "type": "object",
        "description": "Club creation data carried by the canonical multipart JSON part. An optional image part creates the logo. Address is intentionally absent because the current create path drops it; adding it requires a separately approved behavior correction.",
        "required": [
          "id",
          "rawName",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "city": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "website": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClubInternalResponse": {
        "type": "object",
        "description": "Club owner projection without persistence audit timestamps. Nullable contact, location, image, and coordinate values are emitted explicitly when absent.",
        "required": [
          "id",
          "rawName",
          "name",
          "address",
          "city",
          "postalCode",
          "email",
          "phoneNumber",
          "website",
          "logoUrl",
          "active",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "city": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "website": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateClubInternalRequest": {
        "type": "object",
        "description": "Partial club update carried by the canonical multipart JSON part. Omitted and explicit-null ordinary fields preserve stored values. removeLogo is always explicit: false without an image keeps the logo, false with an image replaces it, and true without an image deletes it. removeLogo true with an image is invalid. Every successful update reactivates the club.",
        "required": [
          "removeLogo"
        ],
        "properties": {
          "rawName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "address": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "city": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "website": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "removeLogo": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
