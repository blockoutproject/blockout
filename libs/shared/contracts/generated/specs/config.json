  "paths": {
    "/api/v2/config/app-status": {
      "get": {
        "operationId": "getAppStatus",
        "tags": [
          "AppStatus"
        ],
        "summary": "Get application status",
        "description": "Returns the singleton app-status projection. Authentication is required without a method-level scope.",
        "responses": {
          "200": {
            "description": "Current application status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppStatusInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateAppStatus",
        "tags": [
          "AppStatus"
        ],
        "summary": "Update application status",
        "description": "Applies the compatibility partial-update semantics: omission and explicit null both preserve the stored field.",
        "x-required-scope": "update:maintenance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAppStatusInternalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated application status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppStatusInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/divisions": {
      "get": {
        "operationId": "listDivisions",
        "tags": [
          "Divisions"
        ],
        "summary": "List divisions",
        "description": "Returns the complete active and inactive division catalog in the existing repository-defined compatibility order.",
        "x-required-scope": "read:divisions",
        "responses": {
          "200": {
            "description": "Complete division catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DivisionInternalListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "post": {
        "operationId": "createDivision",
        "tags": [
          "Divisions"
        ],
        "summary": "Create a division",
        "description": "Creates a division from a canonical camelCase JSON part and an optional PNG or JPEG image. The current five-megabyte image and request limits remain adapter-owned compatibility behavior.",
        "x-required-scope": "create:divisions",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/CreateDivisionInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Division created.",
            "headers": {
              "Location": {
                "description": "Canonical location of the created division.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DivisionInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/divisions/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DivisionId"
        }
      ],
      "get": {
        "operationId": "getDivision",
        "tags": [
          "Divisions"
        ],
        "summary": "Get a division",
        "description": "Returns one active or inactive division by its numeric identifier.",
        "x-required-scope": "read:divisions",
        "responses": {
          "200": {
            "description": "Requested division.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DivisionInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateDivision",
        "tags": [
          "Divisions"
        ],
        "summary": "Update a division",
        "description": "Partially updates a division from a canonical camelCase JSON part, optionally replaces its logo, and preserves the existing implicit reactivation behavior.",
        "x-required-scope": "update:divisions",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/UpdateDivisionInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated and active division.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DivisionInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "deactivateDivision",
        "tags": [
          "Divisions"
        ],
        "summary": "Deactivate a division",
        "description": "Soft-deactivates the division and retains its persisted data and logo.",
        "x-required-scope": "delete:divisions",
        "responses": {
          "204": {
            "description": "Division deactivated."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/legal/{type}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/LegalDocumentType"
        }
      ],
      "get": {
        "operationId": "getLegalDocument",
        "tags": [
          "LegalDocuments"
        ],
        "summary": "Get a legal document",
        "description": "Returns a legal document using the exact path value. Missing documents retain the current generic server-error status until a separately approved correction.",
        "security": [],
        "responses": {
          "200": {
            "description": "Requested legal document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalDocumentInternalResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateLegalDocument",
        "tags": [
          "LegalDocuments"
        ],
        "summary": "Update a legal document",
        "description": "Normalizes the path value by trimming and lowercasing it, then applies compatibility partial-update semantics. Missing documents retain the current generic server-error status.",
        "x-required-scope": "update:legal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLegalDocumentInternalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated legal document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalDocumentInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/raw-divisions": {
      "get": {
        "operationId": "listRawDivisionMappings",
        "tags": [
          "RawDivisionMappings"
        ],
        "summary": "List raw division mappings",
        "description": "Returns the complete result for the optional exact league and season filters in the existing repository-defined compatibility order.",
        "x-required-scope": "read:raw_division_mapping",
        "parameters": [
          {
            "$ref": "#/components/parameters/LeagueCode"
          },
          {
            "$ref": "#/components/parameters/Season"
          }
        ],
        "responses": {
          "200": {
            "description": "Complete filtered raw-division mapping result.",
