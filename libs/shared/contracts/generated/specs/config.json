              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawDivisionMappingInternalListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "post": {
        "operationId": "createRawDivisionMapping",
        "tags": [
          "RawDivisionMappings"
        ],
        "summary": "Create a raw division mapping",
        "description": "Creates a raw federation division mapping without accepting persistence identity or audit fields.",
        "x-required-scope": "create:raw_division_mapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRawDivisionMappingInternalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Raw division mapping created.",
            "headers": {
              "Location": {
                "description": "Canonical location of the created raw division mapping.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawDivisionMappingInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/raw-divisions/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RawDivisionMappingId"
        }
      ],
      "get": {
        "operationId": "getRawDivisionMapping",
        "tags": [
          "RawDivisionMappings"
        ],
        "summary": "Get a raw division mapping",
        "description": "Returns one raw division mapping by its numeric identifier.",
        "x-required-scope": "read:raw_division_mapping",
        "responses": {
          "200": {
            "description": "Requested raw division mapping.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawDivisionMappingInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateRawDivisionMapping",
        "tags": [
          "RawDivisionMappings"
        ],
        "summary": "Update a raw division mapping",
        "description": "Replaces the division, format, and gender mapping fields. Explicit null values unmap the corresponding field.",
        "x-required-scope": "update:raw_division_mapping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRawDivisionMappingInternalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated raw division mapping.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawDivisionMappingInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/scrapers/{name}/status": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ScraperName"
        }
      ],
      "get": {
        "operationId": "getScraperStatus",
        "tags": [
          "ScraperStatuses"
        ],
        "summary": "Get scraper status",
        "description": "Returns the enabled switch used by a scraper's fail-closed run gate. Authentication is required without a method-level scope.",
        "responses": {
          "200": {
            "description": "Requested scraper status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScraperStatusInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/scrapers/{name}/enabled": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ScraperName"
        },
        {
          "$ref": "#/components/parameters/ScraperEnabled"
        }
      ],
      "put": {
        "operationId": "updateScraperEnabled",
        "tags": [
          "ScraperStatuses"
        ],
        "summary": "Update scraper enabled state",
        "description": "Replaces the scraper enabled switch and preserves the current upsert behavior when the seeded status row is absent.",
        "x-required-scope": "update:scrapers",
        "responses": {
          "200": {
            "description": "Updated or created scraper status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScraperStatusInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/config/scrapers/status": {
      "get": {
        "operationId": "listScraperStatuses",
        "tags": [
          "ScraperStatuses"
        ],
        "summary": "List scraper statuses",
        "description": "Returns the complete two-scraper catalog in the existing repository-defined compatibility order.",
        "x-required-scope": "read:scrapers",
        "responses": {
          "200": {
            "description": "Complete scraper status catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScraperStatusInternalListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "DivisionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "LegalDocumentType": {
        "name": "type",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 50
        }
      },
      "RawDivisionMappingId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "LeagueCode": {
        "name": "leagueCode",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "Season": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "ScraperName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/ScraperNameEnum"
        }
      },
      "ScraperEnabled": {
        "name": "enabled",
        "in": "query",
        "required": true,
        "schema": {
          "type": "boolean"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "AppStatusInternalResponse": {
        "type": "object",
        "description": "Current application maintenance and minimum-version configuration. Nullable display and store values are emitted as explicit nulls when absent.",
        "required": [
          "maintenance",
          "message",
          "imageUrl",
          "minVersionIos",
          "minVersionAndroid",
          "storeUrlIos",
          "storeUrlAndroid",
          "forceUpdateMessage",
          "lastUpdate"
        ],
        "properties": {
          "maintenance": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "maxLength": 1024,
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 2048,
