{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Teams Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "Teams"
    },
    {
      "name": "TeamClubDiscovery"
    },
    {
      "name": "TeamFollowers"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/teams": {
      "get": {
        "operationId": "listTeams",
        "tags": [
          "Teams"
        ],
        "summary": "List teams",
        "description": "Returns a page of teams ordered by raw name and then identifier. Empty or omitted ids preserve the all-teams filter; compatibility callers that require the legacy complete list aggregate every page.",
        "parameters": [
          {
            "$ref": "#/components/parameters/DivisionId"
          },
          {
            "$ref": "#/components/parameters/TeamFormat"
          },
          {
            "$ref": "#/components/parameters/TeamGender"
          },
          {
            "$ref": "#/components/parameters/TeamSeason"
          },
          {
            "$ref": "#/components/parameters/TeamClubId"
          },
          {
            "$ref": "#/components/parameters/TeamIds"
          },
          {
            "$ref": "#/components/parameters/TeamActive"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested team page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "post": {
        "operationId": "createTeam",
        "tags": [
          "Teams"
        ],
        "summary": "Create a team",
        "description": "Creates a team with server-owned identity, follower count, active state, logo storage, and audit timestamps.",
        "x-required-scope": "create:teams",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeamInternalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Team created.",
            "headers": {
              "Location": {
                "description": "Canonical location of the created team.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/teams/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TeamId"
        }
      ],
      "get": {
        "operationId": "getTeam",
        "tags": [
          "Teams"
        ],
        "summary": "Get a team",
        "description": "Returns one active or inactive team by its numeric identifier.",
        "responses": {
          "200": {
            "description": "Requested team.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateTeam",
        "tags": [
          "Teams"
        ],
        "summary": "Update a team",
        "description": "Partially updates a team from a canonical camelCase JSON part and applies its explicit logo intent.",
        "x-required-scope": "update:teams",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/UpdateTeamInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated team.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "deactivateTeam",
        "tags": [
          "Teams"
        ],
        "summary": "Deactivate a team",
        "description": "Soft-deactivates the team without changing the current direct-delete event behavior.",
        "x-required-scope": "delete:teams",
        "responses": {
          "204": {
            "description": "Team deactivated."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/teams/club-ids": {
      "get": {
        "operationId": "listTeamClubIds",
        "tags": [
          "TeamClubDiscovery"
        ],
        "summary": "List distinct team club identifiers",
        "description": "Returns distinct club identifiers referenced by active or inactive teams, ordered lexicographically. Compatibility callers aggregate every page.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested club identifier page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamClubIdPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/teams/{teamId}/followers/increment": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FollowerTeamId"
        },
        {
          "$ref": "#/components/parameters/FollowerUserId"
        }
      ],
      "post": {
        "operationId": "incrementTeamFollowers",
        "tags": [
          "TeamFollowers"
        ],
        "summary": "Increment the team follower projection",
        "description": "Increments the derived follower count for the canonical favorite owner. The legacy v1 adapter retains its unused full-team response.",
        "x-required-scope": "follow:teams",
        "responses": {
          "204": {
            "description": "Follower projection incremented."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/teams/{teamId}/followers/decrement": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FollowerTeamId"
        },
        {
          "$ref": "#/components/parameters/FollowerUserId"
        }
      ],
      "post": {
        "operationId": "decrementTeamFollowers",
        "tags": [
          "TeamFollowers"
        ],
        "summary": "Decrement the team follower projection",
        "description": "Decrements the derived follower count with the current zero floor. The legacy v1 adapter retains its unused full-team response.",
        "x-required-scope": "follow:teams",
        "responses": {
          "204": {
            "description": "Follower projection decremented."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "TeamId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "FollowerTeamId": {
        "name": "teamId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "DivisionId": {
        "name": "divisionId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "TeamFormat": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/FormatEnum"
        }
      },
      "TeamGender": {
        "name": "gender",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/GenderEnum"
        }
      },
      "TeamSeason": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "TeamClubId": {
        "name": "clubId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "TeamIds": {
        "name": "ids",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/NumericIdentifier"
          }
        }
      },
      "TeamActive": {
        "name": "active",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      "FollowerUserId": {
        "name": "userId",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "TeamInternalPageResponse": {
        "type": "object",
        "description": "One page of teams ordered by raw name ascending and then identifier ascending. Consumers that require the legacy complete list aggregate pages in this order.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "CreateTeamInternalRequest": {
        "type": "object",
        "description": "Team creation input containing only caller-owned identity and classification fields. Server identity, follower projection, lifecycle, logo storage, and audit timestamps are not client-controlled.",
        "required": [
          "clubId",
          "rawName",
          "name",
          "shortName",
          "leagueCode",
          "divisionId",
          "season",
          "format",
          "gender"
        ],
        "properties": {
          "clubId": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "shortName": {
            "type": "string",
            "maxLength": 255
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255
          },
          "divisionId": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "season": {
            "type": "string",
            "maxLength": 255
          },
          "format": {
            "$ref": "#/components/schemas/FormatEnum"
          },
          "gender": {
            "$ref": "#/components/schemas/GenderEnum"
          }
        },
        "additionalProperties": false
      },
      "TeamInternalResponse": {
        "type": "object",
        "description": "Team owner projection without persistence audit timestamps or BFF-derived club coordinates and fallback images.",
        "required": [
          "id",
          "clubId",
          "rawName",
          "name",
          "shortName",
          "leagueCode",
          "divisionId",
          "season",
          "format",
          "gender",
          "followersCount",
          "logoUrl",
          "active"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "clubId": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "shortName": {
            "type": "string",
            "maxLength": 255
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255
          },
          "divisionId": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "season": {
            "type": "string",
            "maxLength": 255
          },
          "format": {
            "$ref": "#/components/schemas/FormatEnum"
          },
          "gender": {
            "$ref": "#/components/schemas/GenderEnum"
          },
          "followersCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "logoUrl": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateTeamInternalRequest": {
        "type": "object",
        "description": "Partial team update carried by the canonical multipart JSON part. Omitted and explicit-null ordinary fields preserve stored values. removeLogo is always explicit: false without an image keeps the logo, false with an image replaces it, and true without an image deletes it. removeLogo true with an image is invalid.",
        "required": [
          "removeLogo"
        ],
        "properties": {
          "clubId": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "rawName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "shortName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "divisionId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NumericIdentifier"
              }
            ],
            "nullable": true
          },
          "season": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatEnum"
              }
            ],
            "nullable": true
          },
          "gender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GenderEnum"
              }
            ],
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "nullable": true
          },
          "removeLogo": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "TeamClubIdPageResponse": {
        "type": "object",
        "description": "One page of distinct club identifiers referenced by any active or inactive team, ordered lexicographically. Consumers that require the legacy complete set aggregate every page.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "NumericIdentifier": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Canonical positive numeric identifier wire shape.",
        "x-java-type": "java.lang.Long"
      },
      "FormatEnum": {
        "type": "string",
        "description": "Supported Blockout team formats.",
        "enum": [
          "SIX",
          "FOUR",
          "TWO"
        ]
      },
      "GenderEnum": {
        "type": "string",
        "description": "Gender category used by Blockout competition data.",
        "enum": [
          "M",
          "F",
          "O"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
