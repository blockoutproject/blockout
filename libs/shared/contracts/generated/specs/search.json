{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Search Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "Search"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/search/clubs": {
      "get": {
        "operationId": "searchClubs",
        "tags": [
          "Search"
        ],
        "summary": "Search clubs",
        "description": "Returns at most five unseeded random examples for a blank query or twenty relevance-ranked matches otherwise. Elasticsearch failures remain indistinguishable from an empty successful result until a separately approved behavior correction.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded club search result, including an empty items array when no result or a hidden store failure occurs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClubSearchInternalListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/search/teams": {
      "get": {
        "operationId": "searchTeams",
        "tags": [
          "Search"
        ],
        "summary": "Search teams",
        "description": "Applies exact optional filters, then returns at most five unseeded random examples for a blank query or twenty relevance-ranked matches otherwise. Equal-score order, timeout termination, and hidden Elasticsearch failure behavior remain unchanged.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          },
          {
            "$ref": "#/components/parameters/SearchSeason"
          },
          {
            "$ref": "#/components/parameters/SearchDivisionId"
          },
          {
            "$ref": "#/components/parameters/SearchFormat"
          },
          {
            "$ref": "#/components/parameters/SearchGender"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded team search result, including an empty items array when no result or a hidden store failure occurs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamSearchInternalListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/search/pools": {
      "get": {
        "operationId": "searchPools",
        "tags": [
          "Search"
        ],
        "summary": "Search pools",
        "description": "Applies exact optional filters, then returns at most five unseeded random examples for a blank query or twenty relevance-ranked matches otherwise. Equal-score order, timeout termination, and hidden Elasticsearch failure behavior remain unchanged.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          },
          {
            "$ref": "#/components/parameters/SearchSeason"
          },
          {
            "$ref": "#/components/parameters/SearchDivisionId"
          },
          {
            "$ref": "#/components/parameters/SearchFormat"
          },
          {
            "$ref": "#/components/parameters/SearchGender"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded pool search result, including an empty items array when no result or a hidden store failure occurs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolSearchInternalListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "SearchQuery": {
        "name": "query",
        "in": "query",
        "required": true,
        "description": "Search text. An empty or whitespace-only value intentionally selects random examples instead of being rejected.",
        "schema": {
          "type": "string"
        }
      },
      "SearchSeason": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "SearchDivisionId": {
        "name": "divisionId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "SearchFormat": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/FormatEnum"
        }
      },
      "SearchGender": {
        "name": "gender",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/GenderEnum"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "ClubSearchInternalListResponse": {
        "type": "object",
        "description": "Bounded club autocomplete results in current Elasticsearch random or relevance order.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/ClubSearchInternalResult"
            }
          }
        },
        "additionalProperties": false
      },
      "TeamSearchInternalListResponse": {
        "type": "object",
        "description": "Bounded team autocomplete results in current Elasticsearch random or relevance order.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/TeamSearchInternalResult"
            }
          }
        },
        "additionalProperties": false
      },
      "PoolSearchInternalListResponse": {
        "type": "object",
        "description": "Bounded pool autocomplete results in current Elasticsearch random or relevance order.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/PoolSearchInternalResult"
            }
          }
        },
        "additionalProperties": false
      },
      "FormatEnum": {
        "type": "string",
        "description": "Supported Blockout team formats.",
        "enum": [
          "SIX",
          "FOUR",
          "TWO"
        ]
      },
      "GenderEnum": {
        "type": "string",
        "description": "Gender category used by Blockout competition data.",
        "enum": [
          "M",
          "F",
          "O"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ClubSearchInternalResult": {
        "type": "object",
        "description": "Club autocomplete result separated from the Elasticsearch document and its derived index-only fields.",
        "required": [
          "id",
          "name",
          "logoUrl",
          "city"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "maxLength": 2048,
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TeamSearchInternalResult": {
        "type": "object",
        "description": "Team autocomplete result containing only current card, label, image, and navigation inputs.",
        "required": [
          "id",
          "name",
          "logoUrl",
          "divisionName",
          "format",
          "gender",
          "season"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "maxLength": 2048,
            "nullable": true
          },
          "divisionName": {
            "type": "string",
            "nullable": true
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatEnum"
              }
            ],
            "nullable": true
          },
          "gender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GenderEnum"
              }
            ],
            "nullable": true
          },
          "season": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PoolSearchInternalResult": {
        "type": "object",
        "description": "Pool autocomplete result containing only current card, label, image, and navigation inputs.",
        "required": [
          "id",
          "name",
          "divisionName",
          "leagueCode",
          "leagueName",
          "season",
          "format",
          "gender",
          "logoUrl"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "divisionName": {
            "type": "string",
            "nullable": true
          },
          "leagueCode": {
            "type": "string",
            "nullable": true
          },
          "leagueName": {
            "type": "string",
            "nullable": true
          },
          "season": {
            "type": "string",
            "nullable": true
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatEnum"
              }
            ],
            "nullable": true
          },
          "gender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GenderEnum"
              }
            ],
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "maxLength": 2048,
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
