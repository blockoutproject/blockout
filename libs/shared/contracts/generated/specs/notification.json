{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Notification Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "NotificationInbox"
    },
    {
      "name": "NotificationPushTokens"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/notifications": {
      "get": {
        "operationId": "listCurrentUserNotifications",
        "tags": [
          "NotificationInbox"
        ],
        "summary": "List the current user's notifications",
        "description": "Returns a zero-based page ordered by createdAt descending and notification identity descending. The v1 adapter retains size, its legacy wrapper, and its existing unstable equal-timestamp ordering until the vertical migration proves parity.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/NotificationPageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested notification page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/notifications/unread-count": {
      "get": {
        "operationId": "getCurrentUserUnreadNotificationCount",
        "tags": [
          "NotificationInbox"
        ],
        "summary": "Get the current user's unread notification count",
        "description": "Returns the count computed from the current user's inbox. The v1 adapter retains its legacy unread field while BFF and Expo projections migrate independently.",
        "responses": {
          "200": {
            "description": "Current unread notification count.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadNotificationCountInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/notifications/{id}/read": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NotificationId"
        }
      ],
      "post": {
        "operationId": "markCurrentUserNotificationRead",
        "tags": [
          "NotificationInbox"
        ],
        "summary": "Mark a notification as read",
        "description": "Preserves the current state-sensitive result: an absent notification or one already marked read returns 404 rather than an idempotent 204.",
        "responses": {
          "204": {
            "description": "Notification marked read."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/notifications/{id}/opened": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NotificationId"
        }
      ],
      "post": {
        "operationId": "markCurrentUserNotificationOpened",
        "tags": [
          "NotificationInbox"
        ],
        "summary": "Mark a notification as opened",
        "description": "Preserves the current state-sensitive result: an absent notification or one already marked opened returns 404 rather than an idempotent 204.",
        "responses": {
          "204": {
            "description": "Notification marked opened."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/notifications/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/NotificationId"
        }
      ],
      "delete": {
        "operationId": "deleteCurrentUserNotification",
        "tags": [
          "NotificationInbox"
        ],
        "summary": "Delete a notification",
        "description": "Deletes only an inbox item owned by the current user. An absent or already deleted item preserves the current 404 result.",
        "responses": {
          "204": {
            "description": "Notification deleted."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/notifications/users/{userId}/push-tokens": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "post": {
        "operationId": "registerUserPushToken",
        "tags": [
          "NotificationPushTokens"
        ],
        "summary": "Register or rotate a user's Expo push token",
        "description": "Retains the approved coexistence path and current token reattachment/rotation behavior. The current implementation does not compare userId with the authenticated subject; correcting that authorization gap, installation identity, unregister behavior, and account-deletion cleanup requires their assigned runtime and privacy tasks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPushTokenInternalRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Push token accepted for registration or rotation."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "NotificationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Notification inbox identity scoped to the current authenticated user.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      },
      "NotificationPageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested inbox page size. The default preserves the current mobile page size while v2 adds a hard bound.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "Canonical positive numeric local Blockout user identifier retained on the approved coexistence route.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "NotificationInternalPageResponse": {
        "type": "object",
        "description": "Stable zero-based inbox page. Consumers derive the next page from pageInfo when hasNext is true.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "UnreadNotificationCountInternalResponse": {
        "type": "object",
        "required": [
          "unreadCount"
        ],
        "properties": {
          "unreadCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "RegisterPushTokenInternalRequest": {
        "type": "object",
        "description": "Validated Blockout push-registration command. Expo delivery messages, tickets, receipts, and provider configuration remain adapter-owned.",
        "required": [
          "expoPushToken",
          "platform",
          "deviceId"
        ],
        "properties": {
          "expoPushToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "platform": {
            "$ref": "#/components/schemas/DevicePlatformEnum"
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "NotificationInternalResponse": {
        "type": "object",
        "description": "Persistence-independent inbox view. Recipient ownership, target storage keys, generic metadata, and read/open timestamps remain behind the application and persistence boundaries.",
        "required": [
          "id",
          "type",
          "title",
          "body",
          "deepLink",
          "divisionId",
          "isRead",
          "isOpened",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "type": {
            "$ref": "#/components/schemas/NotificationTypeEnum"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "deepLink": {
            "type": "string",
            "maxLength": 2048,
            "nullable": true
          },
          "divisionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Explicit enrichment input derived from the persisted metadata tree.",
            "nullable": true
          },
          "isRead": {
            "type": "boolean"
          },
          "isOpened": {
            "type": "boolean"
          },
          "createdAt": {
            "$ref": "#/components/schemas/UtcDateTime"
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "DevicePlatformEnum": {
        "type": "string",
        "description": "Platforms accepted by Blockout notification token contracts.",
        "enum": [
          "IOS",
          "ANDROID",
          "WEB",
          "UNKNOWN"
        ]
      },
      "NotificationTypeEnum": {
        "type": "string",
        "description": "Notification kinds exposed by Blockout REST contracts.",
        "enum": [
          "MATCH_FINISHED",
          "MATCH_LIVE_LINK_CREATED",
          "GENERIC"
        ]
      },
      "UtcDateTime": {
        "type": "string",
        "format": "date-time",
        "description": "RFC 3339 timestamp normalized to UTC on Blockout-owned wires."
      }
    }
  }
}
