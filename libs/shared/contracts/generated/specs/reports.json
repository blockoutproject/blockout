{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Reports Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "Reports"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/reports": {
      "post": {
        "operationId": "createReport",
        "tags": [
          "Reports"
        ],
        "summary": "Submit a Blockout report",
        "description": "Accepts canonical Blockout report context and optional PNG/JPEG attachments. The current sequential S3 upload, GitHub create/update, best-effort Discord notification, partial-success, and five-megabyte file/request behavior remain application and adapter policy.",
        "x-required-scope": "create:reports",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/CreateReportInternalRequest"
                  },
                  "images": {
                    "type": "array",
                    "description": "Optional repeated PNG or JPEG attachments. Empty parts are ignored and no attachment-count limit is currently imposed.",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Report accepted and durable GitHub issue created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportCreatedInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateReportInternalRequest": {
        "type": "object",
        "description": "Blockout-owned report command and diagnostic context. Uploaded attachment URLs are server-owned workflow state and are never accepted from callers.",
        "required": [
          "type",
          "title",
          "description",
          "userName",
          "screen",
          "os"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ReportTypeEnum"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "appVersion": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "userId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UuidIdentifier"
              }
            ],
            "nullable": true
          },
          "userName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "screen": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "deviceModel": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "os": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ReportCreatedInternalResponse": {
        "type": "object",
        "description": "Blockout report-submission result mapped from the durable provider issue. Provider-global ID and provider state remain adapter-owned.",
        "required": [
          "number",
          "htmlUrl",
          "title"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "htmlUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ReportTypeEnum": {
        "type": "string",
        "description": "User-facing Blockout report categories.",
        "enum": [
          "DISPLAY_BUG",
          "DATA_ERROR",
          "LOGO",
          "LIVE",
          "OTHER"
        ]
      },
      "UuidIdentifier": {
        "type": "string",
        "format": "uuid",
        "description": "Canonical UUID identifier wire shape.",
        "x-java-type": "java.util.UUID"
      }
    }
  }
}
