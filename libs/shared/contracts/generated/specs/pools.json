{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Pools Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "Pools"
    },
    {
      "name": "PoolFollowers"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/pools": {
      "get": {
        "operationId": "listPools",
        "tags": [
          "Pools"
        ],
        "summary": "List pools",
        "description": "Returns a page of pools ordered by season descending, name ascending with null names last, and identifier ascending. Empty or omitted ids preserve the all-pools filter; compatibility callers that require the legacy complete list aggregate every page.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PoolLeagueCode"
          },
          {
            "$ref": "#/components/parameters/PoolSeason"
          },
          {
            "$ref": "#/components/parameters/PoolActive"
          },
          {
            "$ref": "#/components/parameters/PoolIds"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested pool page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolInternalPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "post": {
        "operationId": "createPool",
        "tags": [
          "Pools"
        ],
        "summary": "Create a pool",
        "description": "Creates a pool with server-owned identity, follower count, active state, and audit timestamps.",
        "x-required-scope": "create:pools",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePoolInternalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pool created.",
            "headers": {
              "Location": {
                "description": "Canonical location of the created pool.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/pools/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PoolId"
        }
      ],
      "get": {
        "operationId": "getPool",
        "tags": [
          "Pools"
        ],
        "summary": "Get a pool",
        "description": "Returns one active or inactive pool by its numeric identifier.",
        "responses": {
          "200": {
            "description": "Requested pool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updatePool",
        "tags": [
          "Pools"
        ],
        "summary": "Update a pool",
        "description": "Partially updates pool identity, display, classification, or explicit lifecycle state. Omitted and explicit-null fields preserve their current values; active true is explicit reactivation and active false is explicit deactivation.",
        "x-required-scope": "update:pools",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePoolInternalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated pool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoolInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "deactivatePool",
        "tags": [
          "Pools"
        ],
        "summary": "Deactivate a pool",
        "description": "Soft-deactivates the pool without changing the current direct-delete event behavior.",
        "x-required-scope": "delete:pools",
        "responses": {
          "204": {
            "description": "Pool deactivated."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/pools/{poolId}/followers/increment": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FollowerPoolId"
        },
        {
          "$ref": "#/components/parameters/FollowerUserId"
        }
      ],
      "post": {
        "operationId": "incrementPoolFollowers",
        "tags": [
          "PoolFollowers"
        ],
        "summary": "Increment the pool follower projection",
        "description": "Increments the derived follower count for the canonical favorite owner. The legacy v1 adapter retains its unused full-pool response.",
        "x-required-scope": "follow:pools",
        "responses": {
          "204": {
            "description": "Follower projection incremented."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/pools/{poolId}/followers/decrement": {
      "parameters": [
        {
          "$ref": "#/components/parameters/FollowerPoolId"
        },
        {
          "$ref": "#/components/parameters/FollowerUserId"
        }
      ],
      "post": {
        "operationId": "decrementPoolFollowers",
        "tags": [
          "PoolFollowers"
        ],
        "summary": "Decrement the pool follower projection",
        "description": "Decrements the derived follower count with the current zero floor. The legacy v1 adapter retains its unused full-pool response.",
        "x-required-scope": "follow:pools",
        "responses": {
          "204": {
            "description": "Follower projection decremented."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "PoolId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "FollowerPoolId": {
        "name": "poolId",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      },
      "PoolLeagueCode": {
        "name": "leagueCode",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "PoolSeason": {
        "name": "season",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      },
      "PoolActive": {
        "name": "active",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        }
      },
      "PoolIds": {
        "name": "ids",
        "in": "query",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/NumericIdentifier"
          }
        }
      },
      "FollowerUserId": {
        "name": "userId",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/NumericIdentifier"
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "PoolInternalPageResponse": {
        "type": "object",
        "description": "One page of pools ordered by season descending, name ascending with null names last, and identifier ascending. Consumers that require the legacy complete list aggregate pages in this order.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PoolInternalResponse"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "CreatePoolInternalRequest": {
        "type": "object",
        "description": "Pool creation input containing only caller-owned identity, display, and classification fields. Server identity, follower projection, lifecycle, and audit timestamps are not client-controlled.",
        "required": [
          "poolCode",
          "leagueCode",
          "season",
          "leagueName",
          "rawName",
          "name",
          "shortName",
          "divisionId",
          "format",
          "gender"
        ],
        "properties": {
          "poolCode": {
            "type": "string",
            "maxLength": 255
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255
          },
          "season": {
            "type": "string",
            "maxLength": 255
          },
          "leagueName": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "shortName": {
            "type": "string",
            "maxLength": 255
          },
          "divisionId": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "format": {
            "$ref": "#/components/schemas/FormatEnum"
          },
          "gender": {
            "$ref": "#/components/schemas/GenderEnum"
          }
        },
        "additionalProperties": false
      },
      "PoolInternalResponse": {
        "type": "object",
        "description": "Pool owner projection without persistence audit timestamps or BFF-derived division, ranking, match, and team data.",
        "required": [
          "id",
          "poolCode",
          "leagueCode",
          "season",
          "leagueName",
          "rawName",
          "name",
          "shortName",
          "divisionId",
          "format",
          "gender",
          "followersCount",
          "active"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "poolCode": {
            "type": "string",
            "maxLength": 255
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255
          },
          "season": {
            "type": "string",
            "maxLength": 255
          },
          "leagueName": {
            "type": "string",
            "maxLength": 255
          },
          "rawName": {
            "type": "string",
            "maxLength": 255
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "shortName": {
            "type": "string",
            "maxLength": 255
          },
          "divisionId": {
            "$ref": "#/components/schemas/NumericIdentifier"
          },
          "format": {
            "$ref": "#/components/schemas/FormatEnum"
          },
          "gender": {
            "$ref": "#/components/schemas/GenderEnum"
          },
          "followersCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdatePoolInternalRequest": {
        "type": "object",
        "description": "Partial pool update. Omitted and explicit-null fields preserve stored values. Active true explicitly requests reactivation; active false explicitly requests deactivation. Application mapping separates lifecycle intent from identity, display, and classification changes.",
        "properties": {
          "poolCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "leagueCode": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "season": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "leagueName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "rawName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "shortName": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "divisionId": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NumericIdentifier"
              }
            ],
            "nullable": true
          },
          "format": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FormatEnum"
              }
            ],
            "nullable": true
          },
          "gender": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GenderEnum"
              }
            ],
            "nullable": true
          },
          "active": {
            "type": "boolean",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NumericIdentifier": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Canonical positive numeric identifier wire shape.",
        "x-java-type": "java.lang.Long"
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "FormatEnum": {
        "type": "string",
        "description": "Supported Blockout team formats.",
        "enum": [
          "SIX",
          "FOUR",
          "TWO"
        ]
      },
      "GenderEnum": {
        "type": "string",
        "description": "Gender category used by Blockout competition data.",
        "enum": [
          "M",
          "F",
          "O"
        ]
      }
    }
  }
}
