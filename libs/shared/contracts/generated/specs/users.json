{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Users Service Internal API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [
    {
      "name": "UserAccounts"
    },
    {
      "name": "UserIdentity"
    },
    {
      "name": "UserFavorites"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/users/{auth0Id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Auth0Id"
        }
      ],
      "get": {
        "operationId": "getUserByAuth0Id",
        "tags": [
          "UserAccounts"
        ],
        "summary": "Resolve a user account by Auth0 subject",
        "description": "Identity-facing compatibility read. Auth0 remains vendor-owned; the response identifies the account by its canonical local UUID.",
        "responses": {
          "200": {
            "description": "Resolved user account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "updateUserByAuth0Id",
        "tags": [
          "UserAccounts"
        ],
        "summary": "Update a user profile by Auth0 subject",
        "description": "Preserves the current update:current_user scope without adding a path-subject comparison. The canonical command replaces the legacy pictureUrl echo/null protocol with explicit removePicture intent.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "#/components/schemas/UpdateUserProfileInternalRequest"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "additionalProperties": false
              },
              "encoding": {
                "data": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountInternalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLargeProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/users/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": [
          "UserAccounts"
        ],
        "summary": "Get the current user account",
        "description": "Resolves the bearer subject through the users-service identity boundary and returns the canonical local account view.",
        "responses": {
          "200": {
            "description": "Current user account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "put": {
        "operationId": "ensureCurrentUser",
        "tags": [
          "UserAccounts"
        ],
        "summary": "Ensure the current user account",
        "description": "Creates or synchronizes the local account from the bearer subject through the existing Auth0 and account-linking behavior.",
        "responses": {
          "200": {
            "description": "Ensured current user account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountInternalResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "409": {
            "$ref": "#/components/responses/ConflictProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "deleteCurrentUser",
        "tags": [
          "UserAccounts"
        ],
        "summary": "Delete the current user account",
        "description": "Preserves the existing Auth0-first, favorite-event, and local-delete ordering. Storage and cross-service retention corrections remain later explicit work.",
        "responses": {
          "204": {
            "description": "Current user deletion completed."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/users/internal/{auth0Id}/assign-default-role": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Auth0Id"
        }
      ],
      "post": {
        "operationId": "assignDefaultUserRole",
        "tags": [
          "UserIdentity"
        ],
        "summary": "Assign the configured default Auth0 role",
        "description": "Internal identity-adapter operation protected by the exact X-API-KEY value. It preserves the current direct Auth0 role-add behavior.",
        "security": [
          {
            "internalApiKey": []
          }
        ],
        "responses": {
          "204": {
            "description": "Default role assignment completed."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/users/{userId}/favorites": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "get": {
        "operationId": "listUserFavorites",
        "tags": [
          "UserFavorites"
        ],
        "summary": "List favorites for a local user",
        "description": "Authenticated compatibility read over the canonical favorite source. V2 pages by creation order then storage identity; the v1 adapter retains its current unpaged response and repository ordering.",
        "parameters": [
          {
            "$ref": "#/components/parameters/FavoriteEntityType"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Requested favorite page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserFavoritePageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    },
    "/api/v2/users/favorites/follow": {
      "post": {
        "operationId": "followEntity",
        "tags": [
          "UserFavorites"
        ],
        "summary": "Follow a team or pool",
        "description": "Resolves the bearer subject to the canonical local user and preserves idempotent no-op behavior for an existing favorite. TEAM requires follow:teams and POOL requires follow:pools.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequiredFavoriteEntityType"
          },
          {
            "$ref": "#/components/parameters/FavoriteEntityId"
          }
        ],
        "responses": {
          "204": {
            "description": "Favorite present or already present."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      },
      "delete": {
        "operationId": "unfollowEntity",
        "tags": [
          "UserFavorites"
        ],
        "summary": "Unfollow a team or pool",
        "description": "Resolves the bearer subject to the canonical local user and preserves idempotent no-op behavior when the favorite is absent. TEAM requires follow:teams and POOL requires follow:pools.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequiredFavoriteEntityType"
          },
          {
            "$ref": "#/components/parameters/FavoriteEntityId"
          }
        ],
        "responses": {
          "204": {
            "description": "Favorite absent or removed."
          },
          "400": {
            "$ref": "#/components/responses/BadRequestProblem"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedProblem"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenProblem"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundProblem"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerErrorProblem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "internalApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "Exact internal role-assignment key. This scheme is isolated from bearer-authenticated user operations."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Auth0Id": {
        "name": "auth0Id",
        "in": "path",
        "required": true,
        "description": "Auth0 subject accepted only by identity-facing compatibility operations.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "description": "Canonical local Blockout user UUID.",
        "schema": {
          "$ref": "#/components/schemas/UuidIdentifier"
        }
      },
      "FavoriteEntityType": {
        "name": "entityType",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/EntityTypeEnum"
        }
      },
      "RequiredFavoriteEntityType": {
        "name": "entityType",
        "in": "query",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/EntityTypeEnum"
        }
      },
      "FavoriteEntityId": {
        "name": "entityId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "UserAccountInternalResponse": {
        "type": "object",
        "description": "Required account/profile view for current consumers. The local UUID is canonical; Auth0 subject remains only for the audited identity and live-owner compatibility workflows. Names, phone, active state, and persistence update timestamp remain v1-only compatibility fields.",
        "required": [
          "id",
          "auth0Id",
          "email",
          "pseudo",
          "pictureUrl",
          "createdAt",
          "favorites"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UuidIdentifier"
          },
          "auth0Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "pseudo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "pictureUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "nullable": true
          },
          "createdAt": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "favorites": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/UserFavoriteSummary"
            }
          }
        },
        "additionalProperties": false
      },
      "UpdateUserProfileInternalRequest": {
        "type": "object",
        "description": "Profile mutation carried by the canonical multipart JSON part. Omitted or null pseudo preserves the stored value. removePicture false without an image preserves the picture, false with an image replaces it, and true without an image removes it. removePicture true with an image is invalid.",
        "required": [
          "removePicture"
        ],
        "properties": {
          "pseudo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "nullable": true
          },
          "removePicture": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UserFavoritePageResponse": {
        "type": "object",
        "description": "One stable page of canonical favorites ordered by creation ascending and then storage identity ascending.",
        "required": [
          "items",
          "pageInfo"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserFavoriteSummary"
            }
          },
          "pageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "additionalProperties": false
      },
      "UuidIdentifier": {
        "type": "string",
        "format": "uuid",
        "description": "Canonical UUID identifier wire shape."
      },
      "EntityTypeEnum": {
        "type": "string",
        "description": "Entity kinds that can be followed by a Blockout user.",
        "enum": [
          "TEAM",
          "POOL"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "UtcDateTime": {
        "type": "string",
        "format": "date-time",
        "description": "RFC 3339 timestamp normalized to UTC on Blockout-owned wires."
      },
      "UserFavoriteSummary": {
        "type": "object",
        "description": "Favorite identity without persistence row ID, owner relationship, or audit timestamp.",
        "required": [
          "entityType",
          "entityId"
        ],
        "properties": {
          "entityType": {
            "$ref": "#/components/schemas/EntityTypeEnum"
          },
          "entityId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
