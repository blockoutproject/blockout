{
  "openapi": "3.0.3",
  "info": {
    "title": "Blockout Shared API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost"
    }
  ],
  "tags": [],
  "paths": {},
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Zero-based page index. The default ordering is defined by each collection operation.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Requested page size. An owner may impose a lower maximum but must document it on the operation.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Safe request identifier for support and trace correlation.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequestProblem": {
        "description": "The request is malformed or violates the operation contract.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "UnauthorizedProblem": {
        "description": "Authentication is missing or invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ForbiddenProblem": {
        "description": "The authenticated principal is not allowed to perform the operation.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "NotFoundProblem": {
        "description": "The requested resource does not exist or is not visible to the principal.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "ConflictProblem": {
        "description": "The request conflicts with the current resource state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "PayloadTooLargeProblem": {
        "description": "The request payload exceeds the accepted operation limit.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      },
      "InternalServerErrorProblem": {
        "description": "The server could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetail"
            }
          }
        }
      }
    },
    "schemas": {
      "CalendarDate": {
        "type": "string",
        "format": "date",
        "description": "Calendar date without a time zone.",
        "x-java-type": "java.time.LocalDate"
      },
      "DevicePlatformEnum": {
        "type": "string",
        "description": "Platforms accepted by Blockout notification token contracts.",
        "enum": [
          "IOS",
          "ANDROID",
          "WEB",
          "UNKNOWN"
        ]
      },
      "EntityTypeEnum": {
        "type": "string",
        "description": "Entity kinds that can be followed by a Blockout user.",
        "enum": [
          "TEAM",
          "POOL"
        ]
      },
      "FormatEnum": {
        "type": "string",
        "description": "Supported Blockout team formats.",
        "enum": [
          "SIX",
          "FOUR",
          "TWO"
        ]
      },
      "GenderEnum": {
        "type": "string",
        "description": "Gender category used by Blockout competition data.",
        "enum": [
          "M",
          "F",
          "O"
        ]
      },
      "LiveLinkStatusEnum": {
        "type": "string",
        "description": "Moderation and lifecycle states for a match live link.",
        "enum": [
          "ACTIVE",
          "DEACTIVATED",
          "BANNED",
          "EXPIRED",
          "PENDING",
          "REJECTED"
        ]
      },
      "LiveProviderEnum": {
        "type": "string",
        "description": "Supported providers for a match live link.",
        "enum": [
          "YOUTUBE",
          "TWITCH",
          "FACEBOOK"
        ]
      },
      "MatchStatusEnum": {
        "type": "string",
        "description": "Observable Blockout match lifecycle states.",
        "enum": [
          "UPCOMING",
          "FINISHED"
        ]
      },
      "NotificationStatusEnum": {
        "type": "string",
        "description": "Observable notification delivery states.",
        "enum": [
          "SENT",
          "PENDING",
          "DELIVERED",
          "FAILED",
          "SENT_NO_TOKEN"
        ]
      },
      "NotificationTargetTypeEnum": {
        "type": "string",
        "description": "Target kinds supported by Blockout notifications.",
        "enum": [
          "MATCH",
          "GENERIC"
        ]
      },
      "NotificationTypeEnum": {
        "type": "string",
        "description": "Notification kinds exposed by Blockout REST contracts.",
        "enum": [
          "MATCH_FINISHED",
          "MATCH_LIVE_LINK_CREATED",
          "GENERIC"
        ]
      },
      "NumericIdentifier": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "description": "Canonical positive numeric identifier wire shape.",
        "x-java-type": "java.lang.Long"
      },
      "PageInfo": {
        "type": "object",
        "description": "Pagination metadata for zero-based Blockout collection responses. hasNext is guaranteed; totalItems is optional unless an operation explicitly guarantees an exact count.",
        "required": [
          "page",
          "pageSize",
          "hasNext"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalItems": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetail": {
        "type": "object",
        "description": "Canonical Blockout Problem Details body. Legacy v1 error bodies remain compatibility-adapter owned.",
        "required": [
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "ReportTypeEnum": {
        "type": "string",
        "description": "User-facing Blockout report categories.",
        "enum": [
          "DISPLAY_BUG",
          "DATA_ERROR",
          "LOGO",
          "LIVE",
          "OTHER"
        ]
      },
      "ScraperNameEnum": {
        "type": "string",
        "description": "Blockout-owned scraper process identifiers.",
        "enum": [
          "SCRAPER",
          "SCRAPER_CLUBS"
        ]
      },
      "UtcDateTime": {
        "type": "string",
        "format": "date-time",
        "description": "RFC 3339 timestamp normalized to UTC on Blockout-owned wires.",
        "x-java-type": "java.time.Instant"
      },
      "UuidIdentifier": {
        "type": "string",
        "format": "uuid",
        "description": "Canonical UUID identifier wire shape.",
        "x-java-type": "java.util.UUID"
      }
    }
  }
}
