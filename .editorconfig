root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

[mvnw.cmd]
end_of_line = crlf

# Preserve upstream imports, artwork and applied migration history.
[{.agents/**,.specify/**,apps/mobile/assets/**,apps/backend/src/main/resources/db/changelog/**}]
charset = unset
indent_style = unset
indent_size = unset
end_of_line = unset
insert_final_newline = unset
