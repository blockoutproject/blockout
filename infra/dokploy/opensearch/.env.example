# Copy privately per environment; this file does not activate search or load automatically.
# Shared by the independent engine Compose and the backend-only application overlay.
BLOCKOUT_ENVIRONMENT=preproduction
# Native Raw File Mounts use search/tls/* relative to each resource's sibling files/ directory.
BLOCKOUT_SEARCH_TLS_DIRECTORY=../files/search/tls
# Engine only; security directory contents and operator keys never belong to the release backend.
BLOCKOUT_SEARCH_SECURITY_DIRECTORY=../files/search/security
BLOCKOUT_SEARCH_NODE_DN=CN=opensearch-preproduction
BLOCKOUT_SEARCH_ADMIN_DN=CN=search-operator-preproduction
# Backend only; the engine receives its BCrypt hash through private internal_users.yml.
BLOCKOUT_SEARCH_PASSWORD=replace-in-private-environment
# Optional cadence override; omit to keep the application default.
# BLOCKOUT_SEARCH_PROJECTION_FULL_REBUILD_DELAY=2h
