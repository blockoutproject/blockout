{
  "name": "@blockout/local-platform",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "infra/compose",
  "projectType": "application",
  "tags": ["scope:infra", "type:application", "platform:docker"],
  "targets": {
    "config": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "infra/compose",
        "command": "docker compose --file docker-compose.third-party.yml --file docker-compose.app.yml config --quiet"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "infra/compose",
        "command": "docker compose --file docker-compose.third-party.yml --file docker-compose.app.yml up"
      }
    },
    "serve-third-party": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "infra/compose",
        "command": "docker compose --file docker-compose.third-party.yml up"
      }
    },
    "serve-app": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "infra/compose",
        "command": "docker compose --file docker-compose.app.yml up"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "infra/compose",
        "command": "docker compose --file docker-compose.third-party.yml --file docker-compose.app.yml down"
      }
    }
  }
}
